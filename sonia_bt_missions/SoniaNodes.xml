<root BTCPP_format="4">
    <TreeNodesModel>
        <Action ID="AiActivation">
            <input_port name="Model" type="int" default="0">model choice, default = 0</input_port>
            <input_port name="Bottom" type="bool" default="false">true: ON, talse: OFF</input_port>
            <input_port name="Front" type="bool" default="false">true: ON, talse: OFF</input_port>
        </Action>
        <Action ID="AiFilter">
            <input_port name="Object_class" type="std::string">Searched object</input_port>
            <input_port name="Camera" type="int" default="1">1: Front, 0: Bottom</input_port>
            <input_port name="Confidence" type="float" default="0.600000">Ai confidence</input_port>
            <output_port name="Detected_object" type="AiDetection"/>
            <input_port name="Max_depth" type="float" default="25.000000">Maximum allowed depth</input_port>
            <input_port name="Min_detections_before_success" type="unsigned long" default="2">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
            <input_port name="Max_frame_before_failing" type="int" default="0">Maximum allowed frames before failing the object research</input_port>
            <input_port name="Max_time_before_failing_sec" type="float" default="0.000000">Maximum allowed frames before failing the object research</input_port>
        </Action>
        <Action ID="ComputeTrajectoryBetweenDetections">
            <input_port name="Side" type="std::string"/>
            <inout_port name="Trajectory" type="Trajectory"/>
            <input_port name="PositionX" type="float" default="10.000000">Forward distance to travel after centering between the two detections</input_port>
            <input_port name="DetectionB" type="AiDetection"/>
            <input_port name="DetectionA" type="AiDetection"/>
        </Action>
        <Action ID="ControlSetMode">
            <input_port name="set_mode" type="bool" default="false"/>
        </Action>
        <Condition ID="DepthCheck">
            <input_port name="IsSmaller" type="bool" default="false">true: ON, talse: OFF</input_port>
            <input_port name="Target" type="float" default="0.100000">true: ON, talse: OFF</input_port>
        </Condition>
        <Action ID="EnableDisableDVL">
            <input_port name="dvl_input" type="bool" default="false">true: start, false: stop</input_port>
        </Action>
        <Action ID="FaceTheObject">
            <inout_port name="Trajectory" type="Trajectory"/>
            <input_port name="Detection" type="AiDetection"/>
        </Action>
        <Action ID="InitializeTrajectory">
            <output_port name="trajectory" type="Trajectory"/>
        </Action>
        <Action ID="LaunchDropper">
            <input_port name="side" type="std::string">port_side or starboard</input_port>
        </Action>
        <Condition ID="MissionSwitchStatus"/>
        <Action ID="MoveAboveObject">
            <inout_port name="Trajectory" type="Trajectory"/>
            <input_port name="Detection" type="AiDetection"/>
        </Action>
        <Action ID="MoveToObject">
            <input_port name="Offset" type="float"/>
            <inout_port name="Trajectory" type="Trajectory"/>
            <input_port name="Detection" type="AiDetection"/>
        </Action>
        <Action ID="MoveToPoint">
            <inout_port name="Trajectory" type="Trajectory"/>
            <input_port name="Point" type="Point"/>
        </Action>
        <Action ID="ObjectDrifting">
            <inout_port name="Trajectory" type="Trajectory"/>
            <input_port name="Detection" type="AiDetection"/>
        </Action>
        <Action ID="SavePoint">
            <output_port name="Point" type="Point"/>
        </Action>
        <Action ID="SearchWhiteSlalom">
            <output_port name="WhiteSlalomDetection" type="AiDetection"/>
            <input_port name="Max_time_before_failing_sec" type="float" default="0.000000">Timeout in seconds, 0 = disabled</input_port>
            <input_port name="Max_depth" type="float" default="25.000000">Maximum detection distance</input_port>
            <input_port name="Confidence" type="float" default="0.600000">Minimum AI confidence</input_port>
            <input_port name="Min_detections_before_success" type="int" default="5">Minimum valid detections before succeeding</input_port>
            <input_port name="Side" type="std::string" default="Left">Left or Right</input_port>
            <input_port name="RedSlalomDetection" type="AiDetection"/>
        </Action>
        <Action ID="SendTrajectory">
            <input_port name="trajectory" type="Trajectory"/>
            <input_port name="interpolation" type="int" default="0"/>
        </Action>
        <Action ID="ShootTorpedo">
            <input_port name="side" type="std::string">port_side or starboard</input_port>
        </Action>
        <Action ID="SplitTrajectory">
            <output_port name="splittedTrajectory" type="Trajectory"/>
            <input_port name="trajectory" type="Trajectory"/>
            <inout_port name="offset" type="unsigned long"/>
        </Action>
        <Action ID="Tare">
            <input_port name="sensor" type="std::string">imu or depth</input_port>
        </Action>
        <Action ID="TorpedoAiFilter">
            <input_port name="Object_class" type="std::string">Searched object</input_port>
            <input_port name="Camera" type="int" default="1">1: Front, 0: Bottom</input_port>
            <input_port name="Confidence" type="float" default="0.600000">Ai confidence</input_port>
            <output_port name="Detected_object" type="AiDetection"/>
            <input_port name="Max_depth" type="float" default="25.000000">Maximum allowed depth</input_port>
            <input_port name="Min_detections_before_success" type="unsigned long" default="2">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
            <input_port name="Max_frame_before_failing" type="int" default="0">Maximum allowed frames before failing the object research</input_port>
            <input_port name="Max_time_before_failing_sec" type="float" default="0.000000">Maximum allowed frames before failing the object research</input_port>
        </Action>
        <Action ID="TorpedoAiming">
            <inout_port name="Trajectory" type="Trajectory"/>
            <input_port name="TargetOffset" type="float"/>
            <input_port name="LaunchingSide" type="std::string"/>
            <input_port name="Detection" type="AiDetection"/>
        </Action>
        <Action ID="TrajectoryAppendPose">
            <inout_port name="trajectory" type="Trajectory"/>
            <input_port name="positionX" default="0.000000" type="float"/>
            <input_port name="positionY" default="0.000000" type="float"/>
            <input_port name="positionZ" default="0.000000" type="float"/>
            <input_port name="orientationX" default="0.000000" type="float"/>
            <input_port name="orientationY" default="0.000000" type="float"/>
            <input_port name="orientationZ" default="0.000000" type="float"/>
            <input_port name="precision" default="0" type="int"/>
            <input_port name="speed" default="0" type="int"/>
            <input_port name="frame" default="1" type="int"/>
            <input_port name="longRotation" default="false" type="bool"/>
        </Action>
        <Action ID="WaitTargetReached">
            <input_port name="timeout" type="int" default="5"/>
        </Action>
    </TreeNodesModel>
</root>
