<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Bin">
    <Sequence _description="Initial Box approach">
      <SubTree ID="InitialSubmerge"
               Depth="0.5"/>
      <AiActivation Bottom="false"
                    Model="0"
                    Front="true"/>
      <SubTree ID="SearchObjectByRotation"
               Object="BOX_BIN"
               FoundAiDetection="{DetectedBox}"
               Max_time_before_failing_sec="0.0"
               Max_frame_before_failing="0"
               Min_detection_before_success="5"
               Confidence="0.60000"
               Max_depth="25"/>
      <InitializeTrajectory trajectory="{BoxApproachTrajectory}"/>
      <MoveToObject Trajectory="{BoxApproachTrajectory}"
                    Offset="-2.0"
                    Detection="{DetectedBox}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{BoxApproachTrajectory}"
               TimeBeforeFailing="5"/>
      <Sequence _description="Pitch to be able to see the four boxes.">
        <InitializeTrajectory trajectory="{BoxPitchTrajectory}"/>
        <TrajectoryAppendPose precision="0"
                              speed="0"
                              orientationZ="0.000000"
                              orientationY="-30.0"
                              orientationX="0.000000"
                              trajectory="{BoxPitchTrajectory}"
                              longRotation="false"
                              positionX="0.000000"
                              positionY="0.000000"
                              frame="1"
                              positionZ="0.000000"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{BoxPitchTrajectory}"
                 TimeBeforeFailing="5"/>
      </Sequence>
      <Sequence _description="Detect the four boxes.">
        <BinAiFilter Max_frame_before_failing="0"
                     Min_detections_before_success="0"
                     Max_depth="25.000000"
                     Detections="{BinDetections}"
                     Confidence="0.600000"
                     Max_time_before_failing_sec="20.0"
                     Camera="1"/>
      </Sequence>
      <Sequence _description="Back to the initial position (unpitch).">
        <InitializeTrajectory trajectory="{BoxUnpitchTrajectory}"/>
        <TrajectoryAppendPose precision="0"
                              speed="0"
                              orientationZ="0.000000"
                              orientationY="30.0"
                              orientationX="0.000000"
                              trajectory="{BoxUnpitchTrajectory}"
                              longRotation="false"
                              positionX="0.000000"
                              positionY="0.000000"
                              frame="1"
                              positionZ="0.000000"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{BoxUnpitchTrajectory}"
                 TimeBeforeFailing="5"/>
      </Sequence>
      <Sequence _description="Save the origin point and drop all bins in boxes.">
        <SavePoint Point="{BoxOriginPoint}"/>
        <Script code="detection_offset := 0"/>
        <Repeat num_cycles="4">
          <Sequence _description="Drop all bins in the boxes.">
            <Sequence _description="Advance above the first box.">
              <InitializeTrajectory trajectory="{MoveAboveBox}"/>
              <MoveAboveObject Trajectory="{MoveAboveBox}"
                               Detection="{Det}"/>
              <SubTree ID="SendTrajectoryOnly"
                       Trajectory="{MoveAboveBox}"
                       TimeBeforeFailing="5"/>
            </Sequence>
            <Sequence _description="Approach bin.">
              <AiActivation Bottom="true"
                            Model="0"
                            Front="false"/>
              <SplitAiDetection splittedDetections="{BinDetections}"
                                detection="{BinDetection}"
                                offset="{detection_offset}"/>
            </Sequence>
            <Sequence _description="Move above current detection">
              <MoveAboveObject Trajectory="{CurrentDetectionTrajectory}"
                               Detection="{BinDetection}"/>
              <SubTree ID="SendTrajectoryOnly"
                       Trajectory="{BinDetection}"
                       TimeBeforeFailing="5"/>
            </Sequence>
            <Sequence _description="Check with the bottom camera">
              <AiFilter Object_class=""
                        Max_frame_before_failing="0"
                        Detected_object=""
                        Min_detections_before_success="2"
                        Max_depth="25.000000"
                        Confidence="0.600000"
                        Max_time_before_failing_sec="0.000000"
                        Camera="0"/>
            </Sequence>
            <Sequence _description="Back to the origin point.">
              <InitializeTrajectory trajectory="{BoxOriginPointTrajectory}"/>
              <MoveToPoint Trajectory="{BoxOriginPointTrajectory}"
                           OffsetPositionZ="0.000000"
                           OffsetPositionY="0.000000"
                           OffsetPositionX="0.000000"
                           Point="{BoxOriginPoint}"/>
              <SubTree ID="SendTrajectoryOnly"
                       Trajectory="{BoxOriginPointTrajectory}"
                       TimeBeforeFailing="5"/>
            </Sequence>
            <Script code="detection_offset := detection_offset + 1"/>
          </Sequence>
        </Repeat>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="BinOneBox">
    <Sequence name="Dropping in 1 bin">
      <Sequence name="Move above the bin">
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <AiActivation Bottom="false"
                      Model="0"
                      Front="true"/>
        <SubTree ID="SearchObjectByRotation"
                 Object="bin"
                 FoundAiDetection="{FrontAidetection}"
                 Max_time_before_failing_sec="0.0"
                 Max_frame_before_failing="300"
                 Min_detection_before_success="5"
                 Confidence="0.60000"
                 Max_depth="25"/>
        <MoveToObject Trajectory="{Trajectory}"
                      Offset="0"
                      Detection="{FrontAidetection}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="5"/>
      </Sequence>
      <Sequence name="Align the dropper with the bin">
        <AiActivation Bottom="true"
                      Model="0"
                      Front="false"/>
        <Repeat num_cycles="3">
          <Sequence>
            <InitializeTrajectory trajectory="{Trajectory}"/>
            <IfThenElse>
              <ScriptCondition code="ObjectToAim==&quot;gate-shark&quot;"/>
              <AiFilter Object_class="shark"
                        Max_frame_before_failing="300"
                        Detected_object="{AiDetection}"
                        Min_detections_before_success="5"
                        Max_depth="25"
                        Confidence="0.600000"
                        Max_time_before_failing_sec="0.000000"
                        Camera="0"/>
              <AiFilter Object_class="sawfish"
                        Max_frame_before_failing="300"
                        Detected_object="{AiDetection}"
                        Min_detections_before_success="5"
                        Max_depth="25"
                        Confidence="0.600000"
                        Max_time_before_failing_sec="0.000000"
                        Camera="0"/>
            </IfThenElse>
            <MoveAboveObject Trajectory="{Trajectory}"
                             Detection="{AiDetection}"/>
            <SubTree ID="SendTrajectoryOnly"
                     Trajectory="{Trajectory}"
                     TimeBeforeFailing="5"/>
          </Sequence>
        </Repeat>
      </Sequence>
      <LaunchDropper side="port_side"/>
      <AiActivation Bottom="false"
                    Model="0"
                    Front="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="BinTwoBox">
    <Sequence name="Dropping in 2 bins">
      <Sequence name="Move above the bin">
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <AiActivation Bottom="false"
                      Model="0"
                      Front="true"/>
        <SubTree ID="SearchObjectByRotation"
                 Object="BIN_BOX"
                 FoundAiDetection="{FrontAidetection}"
                 Max_time_before_failing_sec="0.0"
                 Max_frame_before_failing="300"
                 Min_detection_before_success="5"
                 Confidence="0.60000"
                 Max_depth="25"/>
        <MoveToObject Trajectory="{Trajectory}"
                      Offset="-1.5"
                      Detection="{FrontAidetection}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="5"/>
      </Sequence>
      <Sequence name="Align the dropper with the bin">
        <AiActivation Bottom="true"
                      Model="0"
                      Front="false"/>
        <Repeat num_cycles="3">
          <Sequence>
            <InitializeTrajectory trajectory="{Trajectory}"/>
            <IfThenElse>
              <ScriptCondition code="ObjectToAim==&quot;gate-shark&quot;"/>
              <AiFilter Object_class="shark"
                        Max_frame_before_failing="300"
                        Detected_object="{AiDetection}"
                        Min_detections_before_success="5"
                        Max_depth="25"
                        Confidence="0.600000"
                        Max_time_before_failing_sec="0.000000"
                        Camera="0"/>
              <AiFilter Object_class="sawfish"
                        Max_frame_before_failing="300"
                        Detected_object="{AiDetection}"
                        Min_detections_before_success="5"
                        Max_depth="25"
                        Confidence="0.600000"
                        Max_time_before_failing_sec="0.000000"
                        Camera="0"/>
            </IfThenElse>
            <MoveAboveObject Trajectory="{Trajectory}"
                             Detection="{AiDetection}"/>
            <SubTree ID="SendTrajectoryOnly"
                     Trajectory="{Trajectory}"
                     TimeBeforeFailing="5"/>
          </Sequence>
        </Repeat>
      </Sequence>
      <LaunchDropper side="port_side"/>
      <Sequence name="Offsetting the sub to see the second bin">
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="1"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"/>
      </Sequence>
      <Sequence name="Align the second dropper with the next bin">
        <Repeat num_cycles="3">
          <Sequence>
            <InitializeTrajectory trajectory="{Trajectory}"/>
            <IfThenElse>
              <ScriptCondition code="ObjectToAim==&quot;gate-shark&quot;"/>
              <AiFilter Object_class="shark"
                        Max_frame_before_failing="300"
                        Detected_object="{AiDetection}"
                        Min_detections_before_success="5"
                        Max_depth="25"
                        Confidence="0.600000"
                        Max_time_before_failing_sec="0.000000"
                        Camera="0"/>
              <AiFilter Object_class="sawfish"
                        Max_frame_before_failing="300"
                        Detected_object="{AiDetection}"
                        Min_detections_before_success="5"
                        Max_depth="25"
                        Confidence="0.600000"
                        Max_time_before_failing_sec="0.000000"
                        Camera="0"/>
            </IfThenElse>
            <MoveAboveObject Trajectory="{Trajectory}"
                             Detection="{AiDetection}"/>
            <SubTree ID="SendTrajectoryOnly"
                     Trajectory="{Trajectory}"
                     TimeBeforeFailing="5"/>
          </Sequence>
        </Repeat>
      </Sequence>
      <LaunchDropper side="starboard"/>
      <AiActivation Bottom="false"
                    Model="0"
                    Front="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <output_port name="Detected_object"
                   type="AiDetection"/>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="unsigned long">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <Action ID="BinAiFilter">
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="unsigned long">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <output_port name="Detections"
                   type="std::vector&lt;AiDetection, std::allocator&lt;AiDetection&gt; &gt;">The detected bin</output_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Action ID="LaunchDropper">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Action ID="MoveAboveObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">0 : Abs, 1 : Rot and Trans Rel, 2 : Rot Abs and Trans Rel, 3 : Rot Rel and Trans Abs, 4 : Prof Abs</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">rotation in Z to give to the sub</input_port>
    </SubTree>
    <Action ID="MoveToObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Offset"
                  type="float"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <Action ID="MoveToPoint">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="OffsetPositionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="OffsetPositionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="OffsetPositionX"
                  default="0.000000"
                  type="float"/>
      <input_port name="Point"
                  type="Point"/>
    </Action>
    <Action ID="SavePoint">
      <output_port name="Point"
                   type="Point"/>
    </Action>
    <SubTree ID="SearchObjectByRotation"
             editable="true">
      <input_port name="Object">Object we are looking for</input_port>
      <output_port name="FoundAiDetection">The AiDetection found during the research</output_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.0">Time that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0">Number of frame that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Min_detection_before_success"
                  default="5">Nombre of detected frame to call a found status</input_port>
      <input_port name="Confidence"
                  default="0.60000">Minimum confidence of the Ai</input_port>
      <input_port name="Max_depth"
                  default="25">Max distance to detect an object</input_port>
    </SubTree>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailing"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
    <Action ID="SplitAiDetection">
      <output_port name="splittedDetections"
                   type="Point"/>
      <input_port name="detection"
                  type="std::vector&lt;Point, std::allocator&lt;Point&gt; &gt;"/>
      <inout_port name="offset"
                  type="unsigned long"/>
    </Action>
    <Action ID="TrajectoryAppendPose">
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
    </Action>
  </TreeNodesModel>

</root>
