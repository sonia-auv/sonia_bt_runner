            </IfThenElse>
            <MoveAboveObject Trajectory="{Trajectory}"
                             Detection="{AiDetection}"/>
            <SubTree ID="SendTrajectoryOnly"
                     Trajectory="{Trajectory}"
                     TimeBeforeFailing="5"/>
          </Sequence>
        </Repeat>
      </Sequence>
      <LaunchDropper side="port_side"/>
      <Sequence name="Offsetting the sub to see the second bin">
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="1"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"/>
      </Sequence>
      <Sequence name="Align the second dropper with the next bin">
        <Repeat num_cycles="3">
          <Sequence>
            <InitializeTrajectory trajectory="{Trajectory}"/>
            <IfThenElse>
              <ScriptCondition code="ObjectToAim==&quot;gate-shark&quot;"/>
              <AiFilter Detected_object="{AiDetection}"
                        Max_time_before_failing_sec="0.000000"
                        Max_frame_before_failing="300"
                        Two_objects_possible="0"
                        Min_detections_before_success="5"
                        Confidence="0.600000"
                        Max_depth="25"
                        Object_class="shark"
                        Camera="0"/>
              <AiFilter Detected_object="{AiDetection}"
                        Max_time_before_failing_sec="0.000000"
                        Max_frame_before_failing="300"
                        Two_objects_possible="0"
                        Min_detections_before_success="5"
                        Confidence="0.600000"
                        Max_depth="25"
                        Object_class="sawfish"
                        Camera="0"/>
            </IfThenElse>
            <MoveAboveObject Trajectory="{Trajectory}"
                             Detection="{AiDetection}"/>
            <SubTree ID="SendTrajectoryOnly"
                     Trajectory="{Trajectory}"
                     TimeBeforeFailing="5"/>
          </Sequence>
        </Repeat>
      </Sequence>
      <LaunchDropper side="starboard"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
    </Sequence>
  </BehaviorTree>

