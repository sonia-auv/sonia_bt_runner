<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Run26">
  <BehaviorTree ID="Bin">
    <Sequence>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <SubTree ID="SearchObjectByRotation"
               StartingAngle="0"
               Object="bin"
               FoundAiDetection="{FrontAidetection}"/>
      <MoveToMission Trajectory="{Trajectory}"
                     Detections="{FrontAidetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailling="5"/>
      <AiActivation Model="0"
                    Bottom="true"
                    Front="false"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <Repeat num_cycles="3">
        <Sequence>
          <InitializeTrajectory trajectory="{Trajectory}"/>
          <AiFilter Detected_object_array="{BotomAIDetection}"
                    Max_frame_before_failling="7"
                    Min_size_output="1"
                    Confidence="0.600000"
                    Max_depth="25"
                    Max_size_output="1"
                    Object_class="shark"
                    Camera="0"/>
          <BinAlignementForDroppers Trajectory="{Trajectory}"
                                    Detections="{BotomAIDetection}"/>
          <SubTree ID="SendTrajectoryOnly"
                   Trajectory="{Trajectory}"
                   TimeBeforeFailling="5"/>
        </Sequence>
      </Repeat>
      <Dropper side="port_side"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="CoinFlip">
    <SubTree ID="MoveSinglePose"
             frame="2.0"
             positionX="0.0"
             positionY="0.0"
             positionZ="0.0"
             orientationX="0.0"
             orientationY="0.0"
             orientationZ="0.0"/>
  </BehaviorTree>

  <BehaviorTree ID="Gate">
    <Sequence>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <Fallback>
        <Sequence>
          <SubTree ID="SearchObjectByRotation"
                   StartingAngle="0"
                   Object="gate-shark"
                   FoundAiDetection="{Aidetection}"/>
          <Script code="DetectedObject:=gate_shark"/>
        </Sequence>
        <Sequence>
          <SubTree ID="SearchObjectByRotation"
                   StartingAngle="0"
                   Object="gate-sawfish"
                   FoundAiDetection="{Aidetection}"/>
          <Script code="DetectedObject:=gate_sawfish"/>
        </Sequence>
      </Fallback>
      <MoveToMission Trajectory="{Trajectory}"
                     Detections="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailling="7"/>
      <SubTree ID="RotateToAbsoluteAngle"
               Angle="0"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Octogon">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run26">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="1"/>
      <SubTree ID="CoinFlip"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 DetectedObject="{FishDetected}"/>
      </ForceSuccess>
      <SubTree ID="TrickshotLegacy"/>
      <ForceSuccess>
        <SubTree ID="Bin"
                 HintAngle="0"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="Torpedos"
                 HintAngle="0"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="Octogon"/>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Torpedos">
    <Sequence>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <SubTree ID="SearchObjectByRotation"
               StartingAngle="0"
               Object="torpedo-poster"
               FoundAiDetection="{AiDetection}"/>
      <TorpedoDriftingAlignement Trajectory="{Trajectory}"
                                 Detections="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailling="5"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiFilter Detected_object_array="{AiDetection}"
                Max_frame_before_failling="15"
                Min_size_output="4"
                Confidence="0.600000"
                Max_depth="25"
                Max_size_output="4"
                Object_class="torpedo-poster"
                Camera="1"/>
      <TorpedoAimingAlignement LaunchingSide="port-side"
                               Trajectory="{Trajectory}"
                               Detections="{AiDetection}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Trickshot">
    <Sequence>
      <SubTree ID="MoveSinglePose"
               frame="4"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.75"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="180"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="180"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="-180"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="-90"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="10"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TrickshotLegacy">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="180"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="10"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
      <output_port name="Detected_object_array"
                   type="AiDetectionArray"/>
      <input_port name="Max_frame_before_failling"
                  type="int">maximum allowed frames</input_port>
      <input_port name="Min_size_output"
                  type="int">minumum number of frames with at least one detection before sending results</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_depth"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Max_size_output"
                  type="int">Max size of the output array</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <SubTree ID="Bin"
             editable="true">
      <input_port name="HintAngle"
                  default="0">The approximation of the angle where the mission is.</input_port>
    </SubTree>
    <Action ID="BinAlignementForDroppers">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detections"
                  type="AiDetectionArray"/>
    </Action>
    <Action ID="Dropper">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <SubTree ID="Gate"
             editable="true">
      <input_port name="DetectedObject">The type of object that the sub will working to</input_port>
    </SubTree>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="1">The depth that the sub will be in the water</input_port>
    </SubTree>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">0 : Abs, 1 : Rot and Trans Rel, 2 : Rot Abs and Trans Rel, 3 : Rot Rel and Trans Abs, 4 : Prof Abs</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">x orientation to go</input_port>
    </SubTree>
    <Action ID="MoveToMission">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detections"
                  type="AiDetectionArray"/>
    </Action>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle"
                  default="0">Angle to position the sub with the pool</input_port>
    </SubTree>
    <SubTree ID="SearchObjectByRotation"
             editable="true">
      <input_port name="StartingAngle"
                  default="0">Angle to give to the sub at the begining of the searching procedure</input_port>
      <input_port name="Object">The name of the object to search</input_port>
      <output_port name="FoundAiDetection">The detection of the ai if he found the object</output_port>
    </SubTree>
    <Action ID="SendTrajectory">
      <input_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailling"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
    <Action ID="TorpedoAimingAlignement">
      <input_port name="LaunchingSide"
                  type="std::string"/>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detections"
                  type="AiDetectionArray"/>
    </Action>
    <Action ID="TorpedoDriftingAlignement">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detections"
                  type="AiDetectionArray"/>
    </Action>
    <SubTree ID="Torpedos"
             editable="true">
      <input_port name="HintAngle"
                  default="0">The approximation of the angle where the torpideos is.</input_port>
    </SubTree>
    <Action ID="TrajectoryAppendPose">
        <inout_port name="trajectory" type="Trajectory"/>
        <input_port name="positionX" type="float" default="0.000000"/>
        <input_port name="positionY" type="float" default="0.000000"/>
        <input_port name="positionZ" type="float" default="0.000000"/>
        <input_port name="orientationX" type="float" default="0.000000"/>
        <input_port name="orientationY" type="float" default="0.000000"/>
        <input_port name="orientationZ" type="float" default="0.000000"/>
        <input_port name="frame" type="int" default="1"/>
        <input_port name="speed" type="int" default="0"/>
        <input_port name="precision" type="int" default="0"/>
        <input_port name="longRotation" type="bool" default="false"/>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
