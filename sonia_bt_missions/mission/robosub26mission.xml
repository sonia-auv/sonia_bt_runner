<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Run26Strategy1">
  <BehaviorTree ID="Run26Strategy1">
    <Sequence name="Strategy 1 : Easy Strategy that every sub can do">
      <SubTree ID="InitialSubmerge"
               Depth="1"/>
      <SubTree ID="CoinFlip"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 Path="{path}"
                 Side="{side}"/>
      </ForceSuccess>
      <SavePoint Point="{point_retour}"/>
      <ForceSuccess>
        <SubTree ID="TrickshotLegacy"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="SlalomSimple"
                 Side="{side}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="ReturnHome"
                 point_retour="{point_retour}"/>
      </ForceSuccess>
      <SubTree ID="Done"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run26Strategy2">
    <Sequence name="Strategy 2 : AUV8 alone strategy">
      <SubTree ID="InitialSubmerge"
               Depth="1"/>
      <SubTree ID="CoinFlip"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 Path="{path}"
                 Side="{side}"/>
      </ForceSuccess>
      <SavePoint Point="{point_retour}"/>
      <ForceSuccess>
        <SubTree ID="TrickshotLegacy"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="SlalomSimple"
                 Side="{side}"
                 _autoremap="false"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="BinOneBox"
                 ObjectToAim="{path}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="Torpedos"
                 ObjectToAim="{path}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="ReturnHome"
                 point_retour="{point_retour}"/>
      </ForceSuccess>
      <SubTree ID="Done"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run26Strategy3AUV8">
    <Sequence name="Strategy for AUV8 with combo sub">
      <SubTree ID="InitialSubmerge"
               Depth="1"/>
      <SubTree ID="CoinFlip"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 Path="{path}"
                 Side="{side}"/>
      </ForceSuccess>
      <SavePoint Point="{point_retour}"/>
      <ForceSuccess>
        <SubTree ID="TrickshotLegacy"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="SlalomSimple"
                 Side="{side}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="BinOneBox"
                 ObjectToAim="{path}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="Torpedos"
                 ObjectToAim="{path}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="ReturnHome"
                 point_retour="{point_retour}"/>
      </ForceSuccess>
      <SubTree ID="Done"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run26Strategy3LITE">
    <Sequence name="Strategy for LITE with combo sub">
      <SubTree ID="InitialSubmerge"
               Depth="1"/>
      <SubTree ID="CoinFlip"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 Path="{path}"
                 Side="{side}"/>
      </ForceSuccess>
      <SavePoint Point="{point_retour}"/>
      <ForceSuccess>
        <SubTree ID="TrickshotLegacy"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="SlalomSimple"
                 Side="{side}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="ReturnHome"
                 point_retour="{point_retour}"/>
      </ForceSuccess>
      <SubTree ID="Done"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run26Strategy4AUV8">
    <Sequence name="Hard Strategy for AUV8 with combo sub">
      <SubTree ID="InitialSubmerge"
               Depth="1"/>
      <SubTree ID="CoinFlip"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 Path="{path}"
                 Side="{side}"/>
      </ForceSuccess>
      <SavePoint Point="{point_retour}"/>
      <ForceSuccess>
        <SubTree ID="TrickshotLegacy"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="SlalomSimple"
                 Side="{side}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="BinTwoBox"
                 ObjectToAim="{path}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="Torpedos"
                 ObjectToAim="{path}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="ReturnHome"
                 point_retour="{point_retour}"/>
      </ForceSuccess>
      <SubTree ID="Done"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run26Strategy4LITE">
    <Sequence name="Hard Strategy for LITE with combo sub">
      <SubTree ID="InitialSubmerge"
               Depth="1"/>
      <SubTree ID="CoinFlip"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 Path="{path}"
                 Side="{side}"/>
      </ForceSuccess>
      <SavePoint Point="{point_retour}"/>
      <ForceSuccess>
        <SubTree ID="TrickshotLegacy"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="SlalomSimple"
                 Side="{side}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="ReturnHome"
                 point_retour="{point_retour}"/>
      </ForceSuccess>
      <SubTree ID="Done"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <SubTree ID="BinOneBox"
             editable="true">
      <input_port name="ObjectToAim"/>
    </SubTree>
    <SubTree ID="BinTwoBox"
             editable="true">
      <input_port name="ObjectToAim">The object in the bin that the sub needs to aim</input_port>
    </SubTree>
    <SubTree ID="Gate"
             editable="true">
      <output_port name="Path">The path that the sub as taken</output_port>
      <output_port name="Side">The left or right side that the sub as taken</output_port>
    </SubTree>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <SubTree ID="ReturnHome"
             editable="true">
      <input_port name="point_retour">The register point after the gate</input_port>
    </SubTree>
    <Action ID="SavePoint">
      <output_port name="Point"
                   type="Point"/>
    </Action>
    <SubTree ID="SlalomSimple"
             editable="true">
      <input_port name="Side">The side for passing the slalom</input_port>
    </SubTree>
    <SubTree ID="Torpedos"
             editable="true">
      <input_port name="ObjectToAim">The object that the sub needs to aim first</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
