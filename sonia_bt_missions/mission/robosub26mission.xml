  <BehaviorTree ID="SlalomRafinee">
    <Sequence>
      <Sequence name="Detection of the red slalom">
        <SubTree ID="SearchObjectByRotation"
                 Object=""
                 FoundAiDetection="{reddetection}"
                 Max_time_before_failing_sec="5"
                 Max_frame_before_failing="300"
                 Min_detection_before_success="5"
                 Confidence="0.60000"
                 Max_depth="25"/>
      </Sequence>
      <Sequence name="Detection of the white slalom">
        <SubTree ID="SearchObjectByRotation"
                 Object=""
                 FoundAiDetection="{whitedetection}"
                 Max_time_before_failing_sec="5"
                 Max_frame_before_failing="300"
                 Min_detection_before_success="5"
                 Confidence="0.60000"
                 Max_depth="25"/>
      </Sequence>
      <Sequence name="Compute a trajectory to pass all the slalom one shot">
        <InitializeTrajectory trajectory="{trajectory}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{trajectory}"
                 TimeBeforeFailing="10"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlalomSimple">
    <Sequence>
      <Sequence name="Detection of the red slalom">
        <SubTree ID="SearchObjectByRotation"
                 Object=""
                 FoundAiDetection="{reddetection}"
                 Max_time_before_failing_sec="5"
                 Max_frame_before_failing="300"
                 Min_detection_before_success="5"
                 Confidence="0.60000"
                 Max_depth="25"/>
      </Sequence>
      <Sequence name="Detection of the white slalom">
        <SubTree ID="SearchObjectByRotation"
                 Object=""
                 FoundAiDetection="{whitedetection}"
                 Max_time_before_failing_sec="5"
                 Max_frame_before_failing="300"
                 Min_detection_before_success="5"
                 Confidence="0.60000"
                 Max_depth="25"/>
      </Sequence>
      <Sequence name="Compute a trajectory to pass all the slalom one shot">
        <InitializeTrajectory trajectory="{trajectory}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{trajectory}"
                 TimeBeforeFailing="10"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Torpedos">
    <Sequence>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <SubTree ID="SearchObjectByRotation"
               Object="torpedo-poster"
               FoundAiDetection="{AiDetection}"
               Max_time_before_failing_sec="0.0"
               Max_frame_before_failing="300"
               Min_detection_before_success="5"
               Confidence="0.60000"
               Max_depth="25"/>
      <MoveToObject Offset="-1.5"
                    Trajectory="{Trajectory}"
                    Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <SubTree ID="TorpedoApproachSequence"/>
      <IfThenElse>
        <ScriptCondition code="ObjectToAim==&quot;gate-shark&quot;"/>
        <Sequence>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="port_side"
                   ObjectToAim="shark"/>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="starboard"
                   ObjectToAim="sawfish"/>
        </Sequence>
        <Sequence>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="starboard"
                   ObjectToAim="sawfish"/>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="port_side"
                   ObjectToAim="shark"/>
        </Sequence>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Trickshot">
    <Sequence>
      <SubTree ID="MoveSinglePose"
               frame="4"
               positionX="0.0"
               positionY="0.0"
               positionZ="1"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0"
                            orientationY="90"
                            orientationZ="0.000000"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="180"
                            orientationY="0.000000"
                            orientationZ="0"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0.000000"
                            orientationY="0.000000"
                            orientationZ="180"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0"
                            orientationY="0.000000"
                            orientationZ="180"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0"
                            orientationY="-180"
                            orientationZ="0"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0"
                            orientationY="-90"
                            orientationZ="0"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="180"
                            orientationY="0.000000"
                            orientationZ="0"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{traj}"
               TimeBeforeFailing="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TrickshotLegacy">
    <Fallback>
      <Sequence>
        <SubTree ID="MoveSinglePose"
                 frame="4.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="1.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"/>
        <InitializeTrajectory trajectory="{traj}"/>
        <TrajectoryAppendPose trajectory="{traj}"
                              positionX="0.000000"
                              positionY="0.000000"
                              positionZ="0.000000"
                              orientationX="0.000000"
                              orientationY="90"
                              orientationZ="0.000000"
                              precision="0"
                              speed="0"
                              frame="1"
                              longRotation="false"/>
        <TrajectoryAppendPose trajectory="{traj}"
                              positionX="0.000000"
                              positionY="0.000000"
                              positionZ="0.000000"
                              orientationX="180"
                              orientationY="0.000000"
                              orientationZ="0.000000"
                              precision="0"
                              speed="0"
                              frame="1"
                              longRotation="false"/>
        <TrajectoryAppendPose trajectory="{traj}"
                              positionX="0.000000"
                              positionY="0.000000"
                              positionZ="0.000000"
                              orientationX="180"
                              orientationY="0.000000"
                              orientationZ="0.000000"
                              precision="0"
                              speed="0"
                              frame="1"
                              longRotation="false"/>
        <TrajectoryAppendPose trajectory="{traj}"
                              positionX="0.000000"
                              positionY="0.000000"
                              positionZ="0.000000"
                              orientationX="0.000000"
                              orientationY="90"
                              orientationZ="0.000000"
                              precision="0"
                              speed="0"
                              frame="1"
                              longRotation="false"/>
        <TrajectoryAppendPose trajectory="{traj}"
                              positionX="0.000000"
