<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Run26">
  <BehaviorTree ID="Bin">
    <Sequence>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <SubTree ID="SearchObjectByRotation"
               Object="bin"
               FoundAiDetection="{FrontAidetection}"
               Max_time_before_failing_sec="0.0"
               Max_frame_before_failing="300"
               Min_detection_before_success="5"
               Confidence="0.60000"
               Max_depth="25"/>
      <MoveToObject Offset="0"
                    Trajectory="{Trajectory}"
                    Detection="{FrontAidetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <AiActivation Model="0.5"
                    Bottom="true"
                    Front="false"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <Repeat num_cycles="3">
        <Sequence>
          <InitializeTrajectory trajectory="{Trajectory}"/>
          <IfThenElse>
            <ScriptCondition code="ObjectToAim==&quot;gate-shark&quot;"/>
            <AiFilter Detected_object="{AiDetection}"
                      Max_time_before_failing_sec="0.000000"
                      Max_frame_before_failing="300"
                      Two_objects_possible="0"
                      Min_detections_before_success="5"
                      Confidence="0.600000"
                      Max_depth="25"
                      Object_class="shark"
                      Camera="0"/>
            <AiFilter Detected_object="{AiDetection}"
                      Max_time_before_failing_sec="0.000000"
                      Max_frame_before_failing="300"
                      Two_objects_possible="0"
                      Min_detections_before_success="5"
                      Confidence="0.600000"
                      Max_depth="25"
                      Object_class="sawfish"
                      Camera="0"/>
          </IfThenElse>
          <MoveAboveObject Trajectory="{Trajectory}"
                           Detection="{AiDetection}"/>
          <SubTree ID="SendTrajectoryOnly"
                   Trajectory="{Trajectory}"
                   TimeBeforeFailing="5"/>
        </Sequence>
      </Repeat>
      <LaunchDropper side="port_side"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="CoinFlip">
    <SubTree ID="RotateToAbsoluteAngle"
             Angle="0"/>
  </BehaviorTree>

  <BehaviorTree ID="DummyPreQualification">
    <Sequence>
      <Sequence _description="Initialize the sub.">
        <SubTree ID="InitialSubmerge"
                 Depth="1"
                 _description="Dive from 1m."/>
      </Sequence>
      <Sequence _description="Move foward until the gate">
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="3.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move foward of 3m."/>
      </Sequence>
      <Sequence _description="Move foward of 10m and change the orientation of z axis to turn.">
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="10"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move foward of 10m."/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="90"
                 _description="Turn in z of 90."/>
      </Sequence>
      <Sequence _description="Turn around the marker">
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.5"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move to turn."/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="-0.5"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move foward in y axis of 0.5m"/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="90.0"
                 _description="Position the sub to finish to turn."/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="-0.5"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move to finish to turn."/>
      </Sequence>
      <Sequence _description="Back to starting point.">
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="-13.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move backward of 10m."/>
        <SubTree ID="Done"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Gate">
    <Sequence>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <Fallback>
        <Sequence>
          <SubTree ID="SearchObjectByRotation"
                   Object="gate-shark"
                   FoundAiDetection="{Aidetection}"
                   Max_time_before_failing_sec="0.00"
                   Max_frame_before_failing="300"
                   Min_detection_before_success="5"
                   Confidence="0.60000"
                   Max_depth="25"/>
          <Script code="DetectedObject:=&quot;gate_shark&quot;"/>
        </Sequence>
        <Sequence>
          <SubTree ID="RotateToAbsoluteAngle"
                   Angle="0"/>
          <SubTree ID="SearchObjectByRotation"
                   Object="gate-sawfish"
                   FoundAiDetection="{Aidetection}"
                   Max_time_before_failing_sec="0.00"
                   Max_frame_before_failing="300"
                   Min_detection_before_success="5"
                   Confidence="0.60000"
                   Max_depth="25"/>
          <Script code="DetectedObject:=&quot;gate_sawfish&quot;"/>
        </Sequence>
      </Fallback>
      <FaceTheObject Trajectory="{Trajectory}"
                     Detection="{Aidetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiFilter Detected_object="{Aidetection}"
                Max_time_before_failing_sec="0.000000"
                Max_frame_before_failing="0"
                Two_objects_possible="0"
                Min_detections_before_success="5"
                Confidence="0.600000"
                Max_depth="25.000000"
                Object_class="{DetectedObject}"
                Camera="1"/>
      <ObjectDrifting Trajectory="{Trajectory}"
                      Detection="{Aidetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiFilter Detected_object="{Aidetection}"
                Max_time_before_failing_sec="0.000000"
                Max_frame_before_failing="300"
                Two_objects_possible="0"
                Min_detections_before_success="5"
                Confidence="0.600000"
                Max_depth="25.000000"
                Object_class="{DetectedObject}"
                Camera="1"/>
      <MoveToObject Offset="1.5"
                    Trajectory="{Trajectory}"
                    Detection="{Aidetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Octogon">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="PreQualification">
    <Sequence>
      <Sequence _description="Init sub.">
        <AiActivation Model="0"
                      Bottom="false"
                      Front="true"
                      _description="Active AI."/>
        <SubTree ID="InitialSubmerge"
                 Depth="1"
                 _description="Dive of 1m."/>
      </Sequence>
      <IfThenElse _description="Detect gate and move foward to it.">
        <Sequence _description="Detect gate and move to it if success.">
          <AiFilter Detected_object="{GateDetection}"
                    Max_time_before_failing_sec="0.0"
                    Max_frame_before_failing="300"
                    Two_objects_possible="0"
                    Min_detections_before_success="5"
                    Confidence="0.600000"
                    Max_depth="25.000000"
                    Object_class="gate-shark"
                    Camera="1"
                    _description="Detect gate"/>
          <MoveToObject Offset="0"
                        Trajectory="{GateTrajectory}"
                        Detection="{GateDetection}"/>
          <SubTree ID="SendTrajectoryOnly"
                   Trajectory="{GateTrajectory}"
                   TimeBeforeFailing="5"/>
        </Sequence>
        <SubTree ID="Nop"/>
        <SubTree ID="MissionFailed"/>
      </IfThenElse>
      <Sequence _description="Move foward of 10m and change the orientation of z axis to turn.">
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="10"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move foward of 10m."/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="90"
                 _description="Turn in z of 90."/>
      </Sequence>
      <Sequence _description="Turn around the marker">
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.5"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move to turn."/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="-0.5"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move foward in y axis of 0.5m"/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="90.0"
                 _description="Position the sub to finish to turn."/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="-0.5"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 _description="Move to finish to turn."/>
      </Sequence>
      <IfThenElse _description="Detect gate and move foward to it.">
        <Sequence>
          <AiFilter Detected_object="{GateDetection}"
                    Max_time_before_failing_sec="0.0"
                    Max_frame_before_failing="300"
                    Two_objects_possible="0"
                    Min_detections_before_success="5"
                    Confidence="0.600000"
                    Max_depth="25.000000"
                    Object_class="gate-shark"
                    Camera="1"
                    _description="Detect gate"/>
          <MoveToObject Offset="0"
                        Trajectory="{GateTrajectory}"
                        Detection="{GateDetection}"/>
          <SubTree ID="SendTrajectoryOnly"
                   Trajectory="{GateTrajectory}"
                   TimeBeforeFailing="5"/>
        </Sequence>
        <SubTree ID="Done"/>
        <SubTree ID="MissionFailed"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run26">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="1"/>
      <SubTree ID="CoinFlip"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 DetectedObject="{FishDetected}"/>
      </ForceSuccess>
      <SubTree ID="TrickshotLegacy"/>
      <ForceSuccess>
        <SubTree ID="Bin"
                 ObjectToAim="{FishDetected}"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="Torpedos"
                 ObjectToAim="{FishDetected}"/>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Torpedos">
    <Sequence>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <SubTree ID="SearchObjectByRotation"
               Object="torpedo-poster"
               FoundAiDetection="{AiDetection}"
               Max_time_before_failing_sec="0.0"
               Max_frame_before_failing="300"
               Min_detection_before_success="5"
               Confidence="0.60000"
               Max_depth="25"/>
      <MoveToObject Offset="-1.5"
                    Trajectory="{Trajectory}"
                    Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <SubTree ID="TorpedoApproachSequence"/>
      <IfThenElse>
        <ScriptCondition code="ObjectToAim==&quot;gate-shark&quot;"/>
        <Sequence>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="port_side"
                   ObjectToAim="shark"/>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="starboard"
                   ObjectToAim="sawfish"/>
        </Sequence>
        <Sequence>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="starboard"
                   ObjectToAim="sawfish"/>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="port_side"
                   ObjectToAim="shark"/>
        </Sequence>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Trickshot">
    <Sequence>
      <SubTree ID="MoveSinglePose"
               frame="4"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.75"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="180"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="180"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="-180"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="-90"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{traj}"
               TimeBeforeFailing="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TrickshotLegacy">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="180"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{traj}"
               TimeBeforeFailing="10"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
      <output_port name="Detected_object"
                   type="AiDetection"/>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed time in ms before failing the object research</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Two_objects_possible"
                  default="0"
                  type="int">0: Only one object can be detected, 1: Two or more object of the same class can be detected</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="int">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <SubTree ID="Bin"
             editable="true">
      <input_port name="ObjectToAim">The object in the bin that the sub needs to aim</input_port>
    </SubTree>
    <Action ID="FaceTheObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="Gate"
             editable="true">
      <input_port name="DetectedObject">The type of object that the sub will working to</input_port>
    </SubTree>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Action ID="LaunchDropper">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <Action ID="MoveAboveObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">0 : Abs, 1 : Rot and Trans Rel, 2 : Rot Abs and Trans Rel, 3 : Rot Rel and Trans Abs, 4 : Prof Abs</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">rotation in Z to give to the sub</input_port>
    </SubTree>
    <Action ID="MoveToObject">
      <input_port name="Offset"
                  type="float"/>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <Action ID="ObjectDrifting">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle">Angle to put to the sub</input_port>
    </SubTree>
    <SubTree ID="SearchObjectByRotation"
             editable="true">
      <input_port name="Object">Object we are looking for</input_port>
      <output_port name="FoundAiDetection">The AiDetection found during the research</output_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.0">Time that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0">Number of frame that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Min_detection_before_success"
                  default="5">Nombre of detected frame to call a found status</input_port>
      <input_port name="Confidence"
                  default="0.60000">Minimum confidence of the Ai</input_port>
      <input_port name="Max_depth"
                  default="25">Max distance to detect an object</input_port>
    </SubTree>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailing"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
    <SubTree ID="TorpedoShootingSequence"
             editable="true">
      <input_port name="TorpedoSide">The torpedo side to launch</input_port>
      <input_port name="ObjectToAim">The object closest to the torpedo target</input_port>
    </SubTree>
    <SubTree ID="Torpedos"
             editable="true">
      <input_port name="ObjectToAim">The object that the sub needs to aim first</input_port>
    </SubTree>
    <Action ID="TrajectoryAppendPose">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionZ"
                  default="0.000000"
