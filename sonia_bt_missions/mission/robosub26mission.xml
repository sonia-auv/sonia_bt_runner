<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Run26">
  <BehaviorTree ID="Bin">
    <Sequence>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <SubTree ID="SearchObjectByRotation"
               Object="bin"
               FoundAiDetection="{FrontAidetection}"
               StartingAngle="0"/>
      <MoveToObject Offset="0"
                    Trajectory="{Trajectory}"
                    Detection="{FrontAidetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"
               TimeBeforeFailling="5"/>
      <AiActivation Model="0"
                    Bottom="true"
                    Front="false"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <Repeat num_cycles="3">
        <Sequence>
          <InitializeTrajectory trajectory="{Trajectory}"/>
          <AiFilter Detected_object="{AiDetection}"
                    Max_time_before_failing_ms="0.000000"
                    Max_frame_before_failing="0"
                    Two_objects_possible="0"
                    Min_detections_before_success="2"
                    Confidence="0.600000"
                    Max_depth="25"
                    Object_class="shark"
                    Camera="0"/>
          <MoveAboveObject Trajectory="{Trajectory}"
                           Detection="{AiDetection}"/>
          <SubTree ID="SendTrajectoryOnly"
                   Trajectory="{Trajectory}"
                   TimeBeforeFailing="5"
                   TimeBeforeFailling="5"/>
        </Sequence>
      </Repeat>
      <Dropper side="port_side"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="CoinFlip">
    <SubTree ID="MoveSinglePose"
             frame="2.0"
             positionX="0.0"
             positionY="0.0"
             positionZ="0.0"
             orientationX="0.0"
             orientationY="0.0"
             orientationZ="0.0"/>
  </BehaviorTree>

  <BehaviorTree ID="Gate">
    <Sequence>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <Fallback>
        <Sequence>
          <SubTree ID="SearchObjectByRotation"
                   Object="gate-shark"
                   FoundAiDetection="{Aidetection}"
                   StartingAngle="0"/>
          <Script code="DetectedObject:=gate_shark"/>
        </Sequence>
        <Sequence>
          <SubTree ID="SearchObjectByRotation"
                   Object="gate-sawfish"
                   FoundAiDetection="{Aidetection}"
                   StartingAngle="0"/>
          <Script code="DetectedObject:=gate_sawfish"/>
        </Sequence>
      </Fallback>
      <MoveToObject Offset="0"
                    Trajectory="{Trajectory}"
                    Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"
               TimeBeforeFailling="7"/>
      <SubTree ID="RotateToAbsoluteAngle"
               Angle="0"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Octogon">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run26">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="1"/>
      <SubTree ID="CoinFlip"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 DetectedObject="{FishDetected}"/>
      </ForceSuccess>
      <SubTree ID="TrickshotLegacy"/>
      <ForceSuccess>
        <SubTree ID="Bin"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="Torpedos"/>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="Octogon"/>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Torpedos">
    <Sequence>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <SubTree ID="SearchObjectByRotation"
               Object="torpedo-poster"
               FoundAiDetection="{AiDetection}"
               StartingAngle="0"/>
      <ObjectDrifting Trajectory="{Trajectory}"
                      Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"
               TimeBeforeFailling="5"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiFilter Detected_object="{AiDetection}"
                Max_time_before_failing_ms="0.000000"
                Max_frame_before_failing="0"
                Two_objects_possible="0"
                Min_detections_before_success="2"
                Confidence="0.600000"
                Max_depth="25"
                Object_class="torpedo-poster"
                Camera="1"/>
      <TorpedoAiming LaunchingSide="port-side"
                     Trajectory="{Trajectory}"
                     Detection="{AiDetection}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Trickshot">
    <Sequence>
      <SubTree ID="MoveSinglePose"
               frame="4"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.75"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="180"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="180"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="-180"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="-90"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{traj}"
               TimeBeforeFailing="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TrickshotLegacy">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="180"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{traj}"
               TimeBeforeFailing="10"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
      <output_port name="Detected_object"
                   type="AiDetection"/>
      <input_port name="Max_time_before_failing_ms"
                  default="0.000000"
                  type="float">Maximum allowed time in ms before failing the object research</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Two_objects_possible"
                  default="0"
                  type="int">0: Only one object can be detected, 1: Two or more object of the same class can be detected</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="int">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <Action ID="Dropper">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <SubTree ID="Gate"
             editable="true">
      <input_port name="DetectedObject"/>
    </SubTree>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <Action ID="MoveAboveObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="MoveSinglePose" editable="true">
        <input_port name="frame" default="1.0">0 : Abs, 1 : Rot and Trans Rel, 2 : Rot Abs and Trans Rel, 3 : Rot Rel and Trans Abs, 4 : Prof Abs</input_port>
        <input_port name="positionX" default="0.0">x value to go</input_port>
        <input_port name="positionY" default="0.0">y value to go</input_port>
        <input_port name="positionZ" default="0.0">z value to go</input_port>
        <input_port name="orientationX" default="0.0">z orientation to go</input_port>
        <input_port name="orientationY" default="0.0">y orientation to go</input_port>
        <input_port name="orientationZ" default="0.0">rotation in Z to give to the sub</input_port>
    </SubTree>
    <Action ID="MoveToObject">
      <input_port name="Offset"
                  type="float"/>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetectionArray"/>
    </Action>
    <Action ID="ObjectDrifting">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle">Angle to put to the sub</input_port>
    </SubTree>
    <SubTree ID="SearchObjectByRotation"
             editable="true">
      <input_port name="Object">Object we are looking for</input_port>
      <input_port name="FoundAiDetection">The AiDetection found during the research</input_port>
    </SubTree>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory"/>
      <input_port name="TimeBeforeFailing"
                  default="5">Time before the movement of the sub is abort</input_port>
    </SubTree>
    <Action ID="TorpedoAiming">
      <input_port name="LaunchingSide"
                  type="std::string"/>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <Action ID="TrajectoryAppendPose">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
    </Action>
  </TreeNodesModel>

</root>
