<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Run26Strategy1SearchRescue">
    <Sequence name="Strategy 1 : Easy Strategy that every sub can do for Survey&amp;Repair">
      <SubTree ID="CoinFlip"
               _autoremap="false"/>
      <ForceSuccess>
        <SubTree ID="Gate"
                 Side="{side}"
                 TargetObject="LIFE PRESERVER"
                 NonTargetObject="COMPAS"/>
      </ForceSuccess>
      <SavePoint Point="{point_retour}"/>
      <ForceSuccess>
        <SubTree ID="TrickshotLegacy"/>
      </ForceSuccess>
      <ForceSuccess>
        <IfThenElse>
          <SubTree ID="SlalomSemiFinal"
                   Side="{side}"/>
          <AlwaysSuccess/>
          <SubTree ID="InitialSubmerge"
                   Depth="0.3"/>
        </IfThenElse>
      </ForceSuccess>
      <ForceSuccess>
        <SubTree ID="ReturnHome"
                 point_retour="{point_retour}"/>
      </ForceSuccess>
      <SubTree ID="Done"/>
    </Sequence>
  </BehaviorTree>

