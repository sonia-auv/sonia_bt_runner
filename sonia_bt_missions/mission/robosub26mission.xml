    <Sequence>
      <Sequence name="Finding the table">
        <AlwaysSuccess/>
      </Sequence>
      <Sequence name="Move in direction of the table">
        <AlwaysSuccess/>
      </Sequence>
      <Sequence name="Move on top of the table">
        <AlwaysSuccess/>
      </Sequence>
      <Sequence name="Submerge inside the octogon">
        <AlwaysSuccess/>
      </Sequence>
      <Sequence name="Submerge on top of the table">
        <AlwaysSuccess/>
      </Sequence>
    </Sequence>
