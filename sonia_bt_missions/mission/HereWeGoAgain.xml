<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="StartThisShit">
  <BehaviorTree ID="AlignSlalom">
    <Sequence>
      <InitializeTrajectory trajectory="{slalom_traj}"/>
      <AiFilter detected_object_array="{slalom_det_arr}"
                Min_detection="3"
                Confidence="0.500000"
                Max_size_output="1"
                Max_depth="10"
                Object_class="red-slalom"
                Max_frame="15"
                Camera="1"/>
      <Alignment lateral_m="{lat_trans}"
                 alignement_by_translation="true"
                 has_metric=""
                 alpha="0.5"
                 normalized_coords="0"
                 norm_x=""
                 bearing_rad=""
                 traj="{slalom_traj}"
                 detections="{slalom_det_arr}"/>
      <SendTrajectory trajectory="{slalom_traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="5"/>
      <IfThenElse>
        <ScriptCondition code="direction==&apos;left&apos;"/>
        <SubTree ID="MoveSinglePose"
                 positionX="0.0"
                 positionY="-0.6"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 frame="1.0"/>
        <SubTree ID="MoveSinglePose"
                 positionX="0.0"
                 positionY="0.6"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 frame="1.0"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

