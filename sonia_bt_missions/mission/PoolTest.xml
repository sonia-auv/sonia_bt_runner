<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Pool01AiBottom">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.5"/>
      <AiActivation Model="0"
                    Bottom="true"
                    Front="false"/>
      <IfThenElse>
        <AiFilter Detected_object="{AiDetection}"
                  Max_time_before_failing_sec="0.000000"
                  Max_frame_before_failing="300"
                  Two_objects_possible="0"
                  Min_detections_before_success="5"
                  Confidence="0.600000"
                  Max_depth="25"
                  Object_class="shark"
                  Camera="0"/>
        <SubTree ID="MissionSuccess"/>
        <SubTree ID="MissionFailed"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Pool02AiFront">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.2"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <IfThenElse>
        <AiFilter Detected_object="{AiDetection}"
                  Max_time_before_failing_sec="0.000000"
                  Max_frame_before_failing="300"
                  Two_objects_possible="0"
                  Min_detections_before_success="5"
                  Confidence="0.60000"
                  Max_depth="25"
                  Object_class="gate-shark"
                  Camera="1"/>
        <SubTree ID="MissionSuccess"/>
        <SubTree ID="MissionFailed"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Pool20Search">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.5"/>
      <IfThenElse>
        <SubTree ID="SearchObjectByRotation"
                 Object="gate-shark"
                 FoundAiDetection="{AiDetection}"
                 Max_time_before_failing_sec="0.0"
                 Max_frame_before_failing="300"
                 Min_detection_before_success="5"
                 Confidence="0.60000"
                 Max_depth="25"/>
        <SubTree ID="MissionSuccess"/>
        <SubTree ID="MissionFailed"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Pool21Gate">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.5"/>
      <IfThenElse>
        <SubTree ID="Gate"
                 DetectedObject="{FishDetection}"/>
        <SubTree ID="MissionSuccess"/>
        <SubTree ID="MissionFailed"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Pool22Bin">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.5"/>
      <IfThenElse>
        <SubTree ID="Bin"
                 ObjectToAim="shark"/>
        <SubTree ID="MissionSuccess"/>
        <SubTree ID="MissionFailed"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="PrequalificationRun">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.5"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
      <output_port name="Detected_object"
                   type="AiDetection"/>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed time in ms before failing the object research</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Two_objects_possible"
                  default="0"
                  type="int">0: Only one object can be detected, 1: Two or more object of the same class can be detected</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="int">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <SubTree ID="Bin"
             editable="true">
      <input_port name="ObjectToAim">The object in the bin that the sub needs to aim</input_port>
    </SubTree>
    <SubTree ID="Gate"
             editable="true">
      <input_port name="DetectedObject">The type of object that the sub will working to</input_port>
    </SubTree>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <SubTree ID="SearchObjectByRotation"
             editable="true">
      <input_port name="Object">Object we are looking for</input_port>
      <output_port name="FoundAiDetection">The AiDetection found during the research</output_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.0">Time that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0">Number of frame that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Min_detection_before_success"
                  default="5">Nombre of detected frame to call a found status</input_port>
      <input_port name="Confidence"
                  default="0.60000">Minimum confidence of the Ai</input_port>
      <input_port name="Max_depth"
                  default="25">Max distance to detect an object</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
