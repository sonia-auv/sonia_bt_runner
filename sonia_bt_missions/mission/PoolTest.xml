<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="TEST">
    <SubTree ID="Gate"
             Side="{side}"
             TargetObject="COMPAS"
             NonTargetObject="LIFE PRESERVER"/>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <SubTree ID="Gate"
             editable="true">
      <output_port name="Side">The left or right side that the sub as taken</output_port>
      <input_port name="TargetObject">Object than the sub looking for.</input_port>
      <input_port name="NonTargetObject">Object that the sub use to make sure it passes on the right side.</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
