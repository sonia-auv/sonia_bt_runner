<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="CoinFlip">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.3"/>
      <SubTree ID="RotateToAbsoluteAngle"
               Angle="0"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="1.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="CommunicationEmitter">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="CommunicationReceiver">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="Gate">
    <Sequence name="Gate SearchRescue">
      <Sequence name="Looking for the SOS image">
        <SubTree ID="InitialSubmerge"
                 Depth="0.3"/>
        <AiActivation Model="0"
                      Bottom="false"
                      Front="true"/>
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <SubTree ID="SearchObjectByRotation"
                 Object="{TargetObject}"
                 FoundAiDetection="{Aidetection}"
                 Max_time_before_failing_sec="5.0"
                 Max_frame_before_failing="0"
                 Min_detection_before_success="10"
                 Confidence="0.60000"
                 Max_depth="25"/>
        <FaceTheObject Trajectory="{Trajectory}"
                       Detection="{Aidetection}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="5"/>
      </Sequence>
      <Sequence name="Position the sub at 90 degree facing the SOS image">
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <AiFilter Detected_object="{Aidetection}"
                  Max_time_before_failing_sec="0.000000"
                  Max_frame_before_failing="0"
                  Min_detections_before_success="10"
                  Confidence="0.600000"
                  Max_depth="25.000000"
                  Object_class="{TargetObject}"
                  Camera="1"/>
        <ObjectDrifting Trajectory="{Trajectory}"
                        Detection="{Aidetection}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="5"/>
      </Sequence>
      <Sequence name="Moving the sub at 1.5 m from the SOS image and we look to the left">
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <AiFilter Detected_object="{Aidetection}"
                  Max_time_before_failing_sec="5.000000"
                  Max_frame_before_failing="0"
                  Min_detections_before_success="10"
                  Confidence="0.600000"
                  Max_depth="25.000000"
                  Object_class="{TargetObject}"
                  Camera="1"/>
        <MoveToObject Offset="-1.5"
                      Trajectory="{Trajectory}"
                      Detection="{Aidetection}"/>
        <TrajectoryAppendPose trajectory="{Trajectory}"
                              positionX="0.000000"
                              positionY="0.000000"
                              positionZ="0.000000"
                              orientationX="0.000000"
                              orientationY="0.000000"
                              orientationZ="45.0"
                              precision="0"
                              speed="0"
                              frame="1"
                              longRotation="false"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="5"/>
      </Sequence>
      <Sequence name="Verify if the compass is on the right">
        <IfThenElse>
          <AiFilter Detected_object="{Aidetection}"
                    Max_time_before_failing_sec="5.000000"
                    Max_frame_before_failing="0"
                    Min_detections_before_success="10"
                    Confidence="0.600000"
                    Max_depth="25.000000"
                    Object_class="{NonTargetObject}"
                    Camera="1"/>
          <Script code="Side:=&quot;Left&quot;"/>
          <Script code="Side:=&quot;Right&quot;"/>
        </IfThenElse>
      </Sequence>
      <Sequence name="We pass the gate">
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <TrajectoryAppendPose trajectory="{Trajectory}"
                              positionX="0.000000"
                              positionY="0.000000"
                              positionZ="0.000000"
                              orientationX="0.000000"
                              orientationY="0.000000"
                              orientationZ="-45.0"
                              precision="0"
                              speed="0"
                              frame="1"
                              longRotation="false"/>
        <TrajectoryAppendPose trajectory="{Trajectory}"
                              positionX="2.0"
                              positionY="0.000000"
                              positionZ="0.000000"
                              orientationX="0.000000"
                              orientationY="0.000000"
                              orientationZ="0.000000"
                              precision="0"
                              speed="0"
                              frame="1"
                              longRotation="false"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="5"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Trickshot">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="1.5"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0"
                            orientationY="90"
                            orientationZ="0.000000"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="180"
                            orientationY="0.000000"
                            orientationZ="0"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0.000000"
                            orientationY="0.000000"
                            orientationZ="180"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0"
                            orientationY="0.000000"
                            orientationZ="180"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0"
                            orientationY="-180"
                            orientationZ="0"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0"
                            orientationY="-90"
                            orientationZ="0"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="180"
                            orientationY="0.000000"
                            orientationZ="0"
                            precision="0"
                            speed="2"
                            frame="1"
                            longRotation="false"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{traj}"
               TimeBeforeFailing="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TrickshotLegacy">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.8"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0.000000"
                            orientationY="90"
                            orientationZ="0.000000"
                            precision="0"
                            speed="0"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="180"
                            orientationY="0.000000"
                            orientationZ="0.000000"
                            precision="0"
                            speed="0"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="180"
                            orientationY="0.000000"
                            orientationZ="0.000000"
                            precision="0"
                            speed="0"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0.000000"
                            orientationY="90"
                            orientationZ="0.000000"
                            precision="0"
                            speed="0"
                            frame="1"
                            longRotation="false"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            positionX="0.000000"
                            positionY="0.000000"
                            positionZ="0.000000"
                            orientationX="0.000000"
                            orientationY="180"
                            orientationZ="0.000000"
                            precision="0"
                            speed="0"
                            frame="1"
                            longRotation="false"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{traj}"
               TimeBeforeFailing="20"/>
      <ControlSetMode set_mode="false"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
      <output_port name="Detected_object"
                   type="AiDetection"/>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed time in ms before failing the object research</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="int">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <Action ID="ControlSetMode">
      <input_port name="set_mode"
                  default="false"
                  type="bool"/>
    </Action>
    <Action ID="FaceTheObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">0 : Abs, 1 : Rot and Trans Rel, 2 : Rot Abs and Trans Rel, 3 : Rot Rel and Trans Abs, 4 : Prof Abs</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">rotation in Z to give to the sub</input_port>
    </SubTree>
    <Action ID="MoveToObject">
      <input_port name="Offset"
                  type="float"/>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <Action ID="ObjectDrifting">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle">Angle to put to the sub</input_port>
    </SubTree>
    <SubTree ID="SearchObjectByRotation"
             editable="true">
      <input_port name="Object">Object we are looking for</input_port>
      <output_port name="FoundAiDetection">The AiDetection found during the research</output_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.0">Time that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0">Number of frame that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Min_detection_before_success"
                  default="5">Nombre of detected frame to call a found status</input_port>
      <input_port name="Confidence"
                  default="0.60000">Minimum confidence of the Ai</input_port>
      <input_port name="Max_depth"
                  default="25">Max distance to detect an object</input_port>
    </SubTree>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailing"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
    <Action ID="TrajectoryAppendPose">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
    </Action>
  </TreeNodesModel>

</root>
