<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Torpedos">
    <Sequence>
      <SubTree ID="TorpedoApproachSequence"/>
      <IfThenElse>
        <ScriptCondition code="Path==&quot;survey-repair&quot;"/>
        <Sequence>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="port_side"
                   ObjectToAim="FIRETRUCK"/>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="starboard"
                   ObjectToAim="FIRE"/>
        </Sequence>
        <Sequence>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="starboard"
                   ObjectToAim="AMPULANCE"/>
          <SubTree ID="TorpedoShootingSequence"
                   TorpedoSide="port_side"
                   ObjectToAim="BLOOD"/>
        </Sequence>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <SubTree ID="TorpedoShootingSequence"
             editable="true">
      <input_port name="TorpedoSide">The torpedo side to launch</input_port>
      <input_port name="ObjectToAim">The object closest to the torpedo target</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
