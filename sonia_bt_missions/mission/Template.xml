<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="BootingSequence">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <Tare sensor="imu"/>
      <EnableDisableDVL dvl_input="true"/>
      <ControlSetMode set_mode="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="InitialSubmerge">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="{Depth}"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MissionFailed">
    <Sequence>
      <ControlSetMode set_mode="false"/>
      <AlwaysFailure/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MissionSuccess">
    <Sequence>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90.0"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="-90.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MoveSinglePose">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="{frame}"
                            orientationZ="{orientationZ}"
                            longRotation="false"
                            positionZ="{positionZ}"
                            positionY="{positionY}"
                            orientationY="{orientationY}"
                            orientationX="{orientationX}"
                            positionX="{positionX}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{traj}"
               TimeBeforeFailing="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="RotateToAbsoluteAngle">
    <SubTree ID="MoveSinglePose"
             frame="2.0"
             positionX="0.0"
             positionY="0.0"
             positionZ="0.0"
             orientationX="0.0"
             orientationY="0.0"
             orientationZ="{Angle}"/>
  </BehaviorTree>

  <BehaviorTree ID="SearchObjectByRotation">
    <Fallback>
      <AiFilter Detected_object="{FoundAiDetection}"
                Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                Max_frame_before_failing="{Max_frame_before_failing}"
                Two_objects_possible="0"
                Min_detections_before_success="{Min_detection_before_success}"
                Confidence="{Confidence}"
                Max_depth="{Max_depth}"
                Object_class="{Object}"
                Camera="1"/>
      <Sequence>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="30"/>
        <Fallback>
          <AiFilter Detected_object="{FoundAiDetection}"
                    Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                    Max_frame_before_failing="{Max_frame_before_failing}"
                    Two_objects_possible="0"
                    Min_detections_before_success="{Min_detection_before_success}"
                    Confidence="{Confidence}"
                    Max_depth="{Max_depth}"
                    Object_class="{Object}"
                    Camera="1"/>
          <Sequence>
            <SubTree ID="MoveSinglePose"
                     frame="1.0"
                     positionX="0.0"
                     positionY="0.0"
                     positionZ="0.0"
                     orientationX="0.0"
                     orientationY="0.0"
                     orientationZ="30"/>
            <Fallback>
              <AiFilter Detected_object="{FoundAiDetection}"
                        Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                        Max_frame_before_failing="{Max_frame_before_failing}"
                        Two_objects_possible="0"
                        Min_detections_before_success="{Min_detection_before_success}"
                        Confidence="{Confidence}"
                        Max_depth="{Max_depth}"
                        Object_class="{Object}"
                        Camera="1"/>
              <Sequence>
                <SubTree ID="MoveSinglePose"
                         frame="1.0"
                         positionX="0.0"
                         positionY="0.0"
                         positionZ="0.0"
                         orientationX="0.0"
                         orientationY="0.0"
                         orientationZ="30"/>
                <Fallback>
                  <AiFilter Detected_object="{FoundAiDetection}"
                            Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                            Max_frame_before_failing="{Max_frame_before_failing}"
                            Two_objects_possible="0"
                            Min_detections_before_success="{Min_detection_before_success}"
                            Confidence="{Confidence}"
                            Max_depth="{Max_depth}"
                            Object_class="{Object}"
                            Camera="1"/>
                  <Sequence>
                    <SubTree ID="MoveSinglePose"
                             frame="1.0"
                             positionX="0.0"
                             positionY="0.0"
                             positionZ="0.0"
                             orientationX="0.0"
                             orientationY="0.0"
                             orientationZ="30"/>
                    <Fallback>
                      <AiFilter Detected_object="{FoundAiDetection}"
                                Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                                Max_frame_before_failing="{Max_frame_before_failing}"
                                Two_objects_possible="0"
                                Min_detections_before_success="{Min_detection_before_success}"
                                Confidence="{Confidence}"
                                Max_depth="{Max_depth}"
                                Object_class="{Object}"
                                Camera="1"/>
                      <Sequence>
                        <SubTree ID="MoveSinglePose"
                                 frame="1.0"
                                 positionX="0.0"
                                 positionY="0.0"
                                 positionZ="0.0"
                                 orientationX="0.0"
                                 orientationY="0.0"
                                 orientationZ="30"/>
                        <Fallback>
                          <AiFilter Detected_object="{FoundAiDetection}"
                                    Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                                    Max_frame_before_failing="{Max_frame_before_failing}"
                                    Two_objects_possible="0"
                                    Min_detections_before_success="{Min_detection_before_success}"
                                    Confidence="{Confidence}"
                                    Max_depth="{Max_depth}"
                                    Object_class="{Object}"
                                    Camera="1"/>
                          <Sequence>
                            <SubTree ID="MoveSinglePose"
                                     frame="1.0"
                                     positionX="0.0"
                                     positionY="0.0"
                                     positionZ="0.0"
                                     orientationX="0.0"
                                     orientationY="0.0"
                                     orientationZ="30"/>
                            <Fallback>
                              <AiFilter Detected_object="{FoundAiDetection}"
                                        Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                                        Max_frame_before_failing="{Max_frame_before_failing}"
                                        Two_objects_possible="0"
                                        Min_detections_before_success="{Min_detection_before_success}"
                                        Confidence="{Confidence}"
                                        Max_depth="{Max_depth}"
                                        Object_class="{Object}"
                                        Camera="1"/>
                              <Sequence>
                                <SubTree ID="MoveSinglePose"
                                         frame="1.0"
                                         positionX="0.0"
                                         positionY="0.0"
                                         positionZ="0.0"
                                         orientationX="0.0"
                                         orientationY="0.0"
                                         orientationZ="30"/>
                                <Fallback>
                                  <AiFilter Detected_object="{FoundAiDetection}"
                                            Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                                            Max_frame_before_failing="{Max_frame_before_failing}"
                                            Two_objects_possible="0"
                                            Min_detections_before_success="{Min_detection_before_success}"
                                            Confidence="{Confidence}"
                                            Max_depth="{Max_depth}"
                                            Object_class="{Object}"
                                            Camera="1"/>
                                  <Sequence>
                                    <SubTree ID="MoveSinglePose"
                                             frame="1.0"
                                             positionX="0.0"
                                             positionY="0.0"
                                             positionZ="0.0"
                                             orientationX="0.0"
                                             orientationY="0.0"
                                             orientationZ="30"/>
                                    <Fallback>
                                      <AiFilter Detected_object="{FoundAiDetection}"
                                                Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                                                Max_frame_before_failing="{Max_frame_before_failing}"
                                                Two_objects_possible="0"
                                                Min_detections_before_success="{Min_detection_before_success}"
                                                Confidence="{Confidence}"
                                                Max_depth="{Max_depth}"
                                                Object_class="{Object}"
                                                Camera="1"/>
                                      <Sequence>
                                        <SubTree ID="MoveSinglePose"
                                                 frame="1.0"
                                                 positionX="0.0"
                                                 positionY="0.0"
                                                 positionZ="0.0"
                                                 orientationX="0.0"
                                                 orientationY="0.0"
                                                 orientationZ="30"/>
                                        <Fallback>
                                          <AiFilter Detected_object="{FoundAiDetection}"
                                                    Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                                                    Max_frame_before_failing="{Max_frame_before_failing}"
                                                    Two_objects_possible="0"
                                                    Min_detections_before_success="{Min_detection_before_success}"
                                                    Confidence="{Confidence}"
                                                    Max_depth="{Max_depth}"
                                                    Object_class="{Object}"
                                                    Camera="1"/>
                                          <Sequence>
                                            <SubTree ID="MoveSinglePose"
                                                     frame="1.0"
                                                     positionX="0.0"
                                                     positionY="0.0"
                                                     positionZ="0.0"
                                                     orientationX="0.0"
                                                     orientationY="0.0"
                                                     orientationZ="30"/>
                                            <Fallback>
                                              <AiFilter Detected_object="{FoundAiDetection}"
                                                        Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                                                        Max_frame_before_failing="{Max_frame_before_failing}"
                                                        Two_objects_possible="0"
                                                        Min_detections_before_success="{Min_detection_before_success}"
                                                        Confidence="{Confidence}"
                                                        Max_depth="{Max_depth}"
                                                        Object_class="{Object}"
                                                        Camera="1"/>
                                              <Sequence>
                                                <SubTree ID="MoveSinglePose"
                                                         frame="1.0"
                                                         positionX="0.0"
                                                         positionY="0.0"
                                                         positionZ="0.0"
                                                         orientationX="0.0"
                                                         orientationY="0.0"
                                                         orientationZ="30"/>
                                                <IfThenElse>
                                                  <AiFilter Detected_object="{FoundAiDetection}"
                                                            Max_time_before_failing_ms="{Max_time_before_failing_ms}"
                                                            Max_frame_before_failing="{Max_frame_before_failing}"
                                                            Two_objects_possible="0"
                                                            Min_detections_before_success="{Min_detection_before_success}"
                                                            Confidence="{Confidence}"
                                                            Max_depth="{Max_depth}"
                                                            Object_class="{Object}"
                                                            Camera="1"/>
                                                  <AlwaysFailure/>
                                                </IfThenElse>
                                              </Sequence>
                                            </Fallback>
                                          </Sequence>
                                        </Fallback>
                                      </Sequence>
                                    </Fallback>
                                  </Sequence>
                                </Fallback>
                              </Sequence>
                            </Fallback>
                          </Sequence>
                        </Fallback>
                      </Sequence>
                    </Fallback>
                  </Sequence>
                </Fallback>
              </Sequence>
            </Fallback>
          </Sequence>
        </Fallback>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="SendTrajectoryOnly">
    <Sequence>
      <SendTrajectory trajectory="{Trajectory}"
                      interpolation="0"/>
      <WaitTargetReached timeout="{TimeBerforeFailling}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TorpedoApproachSequence">
    <Sequence>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <SubTree ID="SearchObjectByRotation"
               Object="torpedo-poster"
               FoundAiDetection="{AiDetection}"
               Max_time_before_failing_ms="0.0"
               Max_frame_before_failing="0"
               Min_detection_before_success="5"
               Confidence="0.60000"
               Max_depth="25"/>
      <FaceTheObject Trajectory="{Trajectory}"
                     Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiFilter Detected_object="{AiDetection}"
                Max_time_before_failing_ms="0.000000"
                Max_frame_before_failing="300"
                Two_objects_possible="0"
                Min_detections_before_success="5"
                Confidence="0.600000"
                Max_depth="25.000000"
                Object_class="torpedo-poster"
                Camera="1"/>
      <ObjectDrifting Trajectory="{Trajectory}"
                      Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiFilter Detected_object="{AiDetection}"
                Max_time_before_failing_ms="0.000000"
                Max_frame_before_failing="300"
                Two_objects_possible="0"
                Min_detections_before_success="5"
                Confidence="0.600000"
                Max_depth="25.000000"
                Object_class="torpedo-poster"
                Camera="1"/>
      <TorpedoAiming Trajectory="{Trajectory}"
                     TargetOffset="1.2"
                     LaunchingSide="sub"
                     Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TorpedoShootingSequence">
    <Sequence>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiFilter Detected_object="{AiDetection}"
                Max_time_before_failing_ms="0.000000"
                Max_frame_before_failing="300"
                Two_objects_possible="0"
                Min_detections_before_success="5"
                Confidence="0.600000"
                Max_depth="25.000000"
                Object_class="{ObjectToAim}"
                Camera="1"/>
      <TorpedoAiming Trajectory="{Trajectory}"
                     TargetOffset="1"
                     LaunchingSide="Sub"
                     Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiFilter Detected_object="{AiDetection}"
                Max_time_before_failing_ms="0.000000"
                Max_frame_before_failing="300"
                Two_objects_possible="1"
                Min_detections_before_success="5"
                Confidence="0.600000"
                Max_depth="25.000000"
                Object_class="torpedo-target"
                Camera="1"/>
      <TorpedoAiming Trajectory="{Trajectory}"
                     TargetOffset="0.3"
                     LaunchingSide="{TorpedoSide}"
                     Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <ShootTorpedo side="{TorpedoSide}"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="-0.9"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <AiFilter Detected_object="{AiDetection}"
                Max_time_before_failing_ms="0.000000"
                Max_frame_before_failing="300"
                Two_objects_possible="0"
                Min_detections_before_success="5"
                Confidence="0.600000"
                Max_depth="25.000000"
                Object_class="torpedo-poster"
                Camera="1"/>
      <TorpedoAiming Trajectory="{Trajectory}"
                     TargetOffset="1.2"
                     LaunchingSide="Sub"
                     Detection="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiFilter">
      <output_port name="Detected_object"
                   type="AiDetection"/>
      <input_port name="Max_time_before_failing_ms"
                  default="0.000000"
                  type="float">Maximum allowed time in ms before failing the object research</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Two_objects_possible"
                  default="0"
                  type="int">0: Only one object can be detected, 1: Two or more object of the same class can be detected</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="int">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <Action ID="ControlSetMode">
      <input_port name="set_mode"
                  default="false"
                  type="bool"/>
    </Action>
    <Action ID="EnableDisableDVL">
      <input_port name="dvl_input"
                  default="false"
                  type="bool">true: start, false: stop</input_port>
    </Action>
    <Action ID="FaceTheObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">0 : Abs, 1 : Rot and Trans Rel, 2 : Rot Abs and Trans Rel, 3 : Rot Rel and Trans Abs, 4 : Prof Abs</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">rotation in Z to give to the sub</input_port>
    </SubTree>
    <Action ID="ObjectDrifting">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="SearchObjectByRotation"
             editable="true">
      <input_port name="Object">Object we are looking for</input_port>
      <output_port name="FoundAiDetection">The AiDetection found during the research</output_port>
      <input_port name="Max_time_before_failing_ms"
                  default="0.0">Time that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0">Number of frame that the sub will take to every 30 degree position to find the object</input_port>
      <input_port name="Min_detection_before_success"
                  default="5">Nombre of detected frame to call a found status</input_port>
      <input_port name="Confidence"
                  default="0.60000">Minimum confidence of the Ai</input_port>
      <input_port name="Max_depth"
                  default="25">Max distance to detect an object</input_port>
    </SubTree>
    <Action ID="SendTrajectory">
      <input_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailing"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
    <Action ID="ShootTorpedo">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Action ID="Tare">
      <input_port name="sensor"
                  type="std::string">imu or depth</input_port>
    </Action>
    <Action ID="TorpedoAiming">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="TargetOffset"
                  type="float"/>
      <input_port name="LaunchingSide"
                  type="std::string"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <Action ID="TrajectoryAppendPose">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
