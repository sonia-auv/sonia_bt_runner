<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="ReturnHome">
    <Sequence>
      <Sequence name="Move in direction of the gate">
        <SubTree ID="InitialSubmerge"
                 Depth="0.3"/>
        <SubTree ID="RotateToAbsoluteAngle"
                 Angle="180"/>
        <InitializeTrajectory trajectory="{trajectory}"/>
        <MoveToPoint Trajectory="{trajectory}"
                     OffsetPositionZ="0.000000"
                     OffsetPositionY="0.0000"
                     OffsetPositionX="0.000000"
                     Point="{point_retour}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{trajectory}"
                 TimeBeforeFailing="15"/>
      </Sequence>
      <Sequence name="Pass throw the gate">
        <InitializeTrajectory trajectory="{trajectory}"/>
        <TrajectoryAppendPose precision="0"
                              speed="0"
                              orientationZ="180"
                              orientationY="0.000000"
                              orientationX="0.000000"
                              trajectory="{trajectory}"
                              longRotation="false"
                              positionX="0.000000"
                              positionY="0.000000"
                              frame="2"
                              positionZ="0.000000"/>
        <TrajectoryAppendPose precision="0"
                              speed="0"
                              orientationZ="180"
                              orientationY="0.000000"
                              orientationX="0.000000"
                              trajectory="{trajectory}"
                              longRotation="false"
                              positionX="0"
                              positionY="0.000000"
                              frame="0"
                              positionZ="0.000000"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{trajectory}"
                 TimeBeforeFailing="15"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Action ID="MoveToPoint">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="OffsetPositionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="OffsetPositionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="OffsetPositionX"
                  default="0.000000"
                  type="float"/>
      <input_port name="Point"
                  type="Point"/>
    </Action>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle">Angle to put to the sub</input_port>
    </SubTree>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailing"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
    <Action ID="TrajectoryAppendPose">
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
    </Action>
  </TreeNodesModel>

</root>
