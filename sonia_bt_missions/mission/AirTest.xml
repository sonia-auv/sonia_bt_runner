<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="AirAiRotateToMission">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <AiFilter Detected_object_array="{AiDetection}"
                Max_frame_before_failling="100"
                Min_size_output="1"
                Confidence="0.300000"
                Max_size_output="1"
                Max_depth="25"
                Object_class="gate"
                Camera="1"/>
      <RotateToMission trajectory="{Trajectory}"
                       detections="{AiDetection}"/>
      <AiActivation Model="0"
                    Bottom="true"
                    Front="false"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
        <output_port name="Detected_object_array" type="AiDetectionArray"/>
        <input_port name="Max_frame_before_failling" type="int">maximum allowed frames</input_port>
        <input_port name="Min_size_output" type="int">minumum number of frames with at least one detection before sending results</input_port>
        <input_port name="Confidence" default="0.600000" type="float">Ai confidence</input_port>
        <input_port name="Max_depth" type="float">Maximum allowed depth</input_port>
        <input_port name="Max_size_output" type="int">Max size of the output array</input_port>
        <input_port name="Object_class" type="std::string">Searched object</input_port>
        <input_port name="Camera" default="1" type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <Action ID="RotateToMission">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="detections"
                  type="AiDetectionArray"/>
    </Action>
  </TreeNodesModel>

</root>
