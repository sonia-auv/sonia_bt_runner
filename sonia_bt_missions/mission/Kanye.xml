<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="debug">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <Delay delay_msec="500">
        <Dropper side="port_side"/>
      </Delay>
      <Delay delay_msec="500">
        <Torpedo side="starboard"/>
      </Delay>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Dropper">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <Action ID="Torpedo">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
  </TreeNodesModel>

</root>
