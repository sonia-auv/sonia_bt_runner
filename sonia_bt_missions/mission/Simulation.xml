<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
    <BehaviorTree ID="SimulationAbstract">
        <Sequence>
            <Sequence>
                <Script code="initialDepth := 0.5"/>
                <Script code="option := &apos;&apos;"/>
                <ParseOptions hasBin="{hasBin}" hasCoinFlip="{hasCoinFlip}" hasGate="{hasGate}" hasOctogon="{hasOctogon}" hasRepair="{hasRepair}" hasRescue="{hasRescue}" hasReturnHome="{hasReturnHome}" hasSlalom="{hasSlalom}" hasTorpedo="{hasTorpedo}" hasTrickshot="{hasTrickshot}" option="{option}"/>
            </Sequence>
            <SubTree ID="InitialSubmerge" Depth="{initialDepth}"/>
            <SubTree ID="MoveSinglePose" frame="1" orientationX="0.0" orientationY="0.0" orientationZ="0.0" positionX="5.0" positionY="0.0" positionZ="0.0"/>
            <ForceSuccess>
                <Sequence>
                    <IfThenElse>
                        <ScriptCondition code="hasCoinFlip"/>
                        <SubTree ID="CoinFlip"/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence>
                    <IfThenElse>
                        <ScriptCondition code="hasGate"/>
                        <AlwaysSuccess/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence>
                    <IfThenElse>
                        <ScriptCondition code="hasReturnHome"/>
                        <SavePoint Point="{returnHomePoint}"/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence>
                    <IfThenElse>
                        <ScriptCondition code="hasTrickshot"/>
                        <AlwaysSuccess/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence>
                    <IfThenElse>
                        <ScriptCondition code="hasSlalom"/>
                        <AlwaysSuccess/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence>
                    <IfThenElse>
                        <ScriptCondition code="hasTorpedo"/>
                        <AlwaysSuccess/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence>
                    <IfThenElse>
                        <ScriptCondition code="hasOctogon"/>
                        <AlwaysSuccess/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence>
                    <IfThenElse>
                        <ScriptCondition code="hasBin"/>
                        <AlwaysSuccess/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </ForceSuccess>
            <ForceSuccess>
                <Sequence>
                    <IfThenElse>
                        <ScriptCondition code="hasReturnHome"/>
                        <AlwaysSuccess/>
                        <AlwaysSuccess/>
                    </IfThenElse>
                </Sequence>
            </ForceSuccess>
        </Sequence>
    </BehaviorTree>
    <TreeNodesModel>
        <SubTree ID="InitialSubmerge" editable="true">
            <input_port name="Depth" default="0.5"/>
        </SubTree>
    </TreeNodesModel>
</root>
