<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" project_name="Sonia">
    <include path="Kanye.xml"/>
    <include path="Test1.xml"/>
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Action ID="AiActivation">
            <input_port name="Bottom" default="false" type="bool">true: ON, talse: OFF</input_port>
            <input_port name="Model" default="0" type="int">model choice, default = 0</input_port>
            <input_port name="Front" default="false" type="bool">true: ON, talse: OFF</input_port>
        </Action>
        <Action ID="AiFilter">
            <output_port name="detected_object_array" type="AiDetectionArray"/>
            <input_port name="Max_frame" type="int">maximum allowed frames</input_port>
            <input_port name="Max_depth" type="float">Maximum allowed depth</input_port>
            <input_port name="Min_detection" type="int">minumum number of frames with at least one detection before sending results</input_port>
            <input_port name="Confidence" default="0.600000" type="float">Ai confidence</input_port>
            <input_port name="Object_class" type="std::string">Searched object</input_port>
            <input_port name="Max_size_output" type="int">Max size of the output array</input_port>
            <input_port name="Camera" default="1" type="int">0: Front, 1: Bottom</input_port>
        </Action>
        <SubTree ID="AlignSlalom" editable="true">
            <input_port name="direction" default="left">Side of slalom to move</input_port>
        </SubTree>
        <Action ID="Alignment">
            <output_port name="has_metric" type="int"/>
            <output_port name="norm_x" type="float"/>
            <output_port name="bearing_rad" type="float"/>
            <inout_port name="traj" type="Trajectory"/>
            <output_port name="lateral_m" type="float"/>
            <input_port name="alignement_by_translation" type="bool"/>
            <input_port name="alpha" type="float"/>
            <input_port name="normalized_coords" type="bool"/>
            <input_port name="detections" type="AiDetectionArray"/>
        </Action>
        <Action ID="ControlSetMode">
            <input_port name="set_mode" default="false" type="bool"/>
        </Action>
        <Condition ID="DepthCheck">
            <input_port name="IsSmaller" default="false" type="bool">true: ON, talse: OFF</input_port>
            <input_port name="Target" default="0.100000" type="float">true: ON, talse: OFF</input_port>
        </Condition>
        <Action ID="Dropper">
            <input_port name="side" type="std::string">port_side or starboard</input_port>
        </Action>
        <Action ID="EnableDisableDVL">
            <input_port name="dvl_input" default="false" type="bool">true: start, false: stop</input_port>
        </Action>
        <Action ID="InitializeTrajectory">
            <output_port name="trajectory" type="Trajectory"/>
        </Action>
        <Condition ID="MissionSwitchStatus"/>
        <SubTree ID="MoveSinglePose" editable="true">
            <input_port name="positionX" default="0.0"/>
            <input_port name="positionY" default="0.0"/>
            <input_port name="positionZ" default="0.0"/>
            <input_port name="orientationX" default="0.0"/>
            <input_port name="orientationY" default="0.0"/>
            <input_port name="orientationZ" default="0.0"/>
            <input_port name="frame" default="1.0"/>
        </SubTree>
        <SubTree ID="PositionAbsolutAngle" editable="true">
            <input_port name="angle"/>
        </SubTree>
        <Action ID="SendTrajectory">
            <input_port name="trajectory" type="Trajectory"/>
            <input_port name="interpolation" default="0" type="int"/>
        </Action>
        <Action ID="Tare">
            <input_port name="sensor" type="std::string">imu or depth</input_port>
        </Action>
        <Action ID="Torpedo">
            <input_port name="side" type="std::string">port_side or starboard</input_port>
        </Action>
        <Action ID="TrajectoryAppendPose">
            <input_port name="precision" default="0" type="int"/>
            <input_port name="speed" default="0" type="int"/>
            <input_port name="orientationZ" default="0.000000" type="float"/>
            <input_port name="orientationY" default="0.000000" type="float"/>
            <input_port name="orientationX" default="0.000000" type="float"/>
            <input_port name="frame" default="1" type="int"/>
            <input_port name="positionZ" default="0.000000" type="float"/>
            <inout_port name="trajectory" type="Trajectory"/>
            <input_port name="longRotation" default="false" type="bool"/>
            <input_port name="positionY" default="0.000000" type="float"/>
            <input_port name="positionX" default="0.000000" type="float"/>
        </Action>
        <Action ID="WaitTargetReached">
            <input_port name="timeout" default="5" type="int"/>
        </Action>
        <SubTree ID="bin_position_bottom" editable="true">
            <input_port name="object_class"/>
            <output_port name="y_found"/>
            <output_port name="x_found"/>
        </SubTree>
        <SubTree ID="bin_position_front" editable="true">
            <input_port name="object_class"/>
            <output_port name="object_distance"/>
        </SubTree>
        <SubTree ID="bin_search_bottom" editable="true">
            <input_port name="object_class"/>
            <output_port name="y_found"/>
            <output_port name="x_found"/>
        </SubTree>
        <SubTree ID="bin_search_front" editable="true">
            <input_port name="object_class"/>
            <output_port name="object_distance"/>
        </SubTree>
        <SubTree ID="gate_solo" editable="true">
            <input_port name="choix_translation" default="true"/>
        </SubTree>
        <SubTree ID="search_rot" editable="true">
            <input_port name="object_class"/>
        </SubTree>
    </TreeNodesModel>
</root>
