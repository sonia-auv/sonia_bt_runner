  </BehaviorTree>

  <BehaviorTree ID="ScanSlalomLayer">
    <Sequence _description="Rotate from From to To by steps of 30 degrees (absolute angles) and accumulate every slalom detection (color ignored) as a point relative to the scan position.">
      <Script code="scan_angle := From"/>
      <Script code="scan_step := 30"/>
      <SubTree ID="RotateToAbsoluteAngle"
               Angle="{scan_angle}"/>
      <ForceSuccess>
        <SlalomScan Actual_angle="{scan_angle}"
                    Invert_camera_angle="false"
                    Points="{Points}"
                    Max_frame_before_failing="0"
                    Min_detections_before_success="5"
                    Max_depth="25.000000"
                    Confidence="0.600000"
                    Max_time_before_failing_sec="3.0"
                    Camera="1"/>
      </ForceSuccess>
      <ForceSuccess>
        <Repeat num_cycles="-1">
          <Sequence>
            <ScriptCondition code="(From &lt; To &amp;&amp; scan_angle &lt; To) || (From &gt; To &amp;&amp; scan_angle &gt; To)"/>
            <IfThenElse>
              <ScriptCondition code="From &lt; To"/>
              <Script code="scan_angle += scan_step"/>
              <Script code="scan_angle -= scan_step"/>
            </IfThenElse>
            <SubTree ID="RotateToAbsoluteAngle"
                     Angle="{scan_angle}"/>
            <ForceSuccess>
              <SlalomScan Actual_angle="{scan_angle}"
                          Invert_camera_angle="false"
                          Points="{Points}"
                          Max_frame_before_failing="0"
                          Min_detections_before_success="5"
                          Max_depth="25.000000"
                          Confidence="0.600000"
                          Max_time_before_failing_sec="3.0"
                          Camera="1"/>
            </ForceSuccess>
          </Sequence>
        </Repeat>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

