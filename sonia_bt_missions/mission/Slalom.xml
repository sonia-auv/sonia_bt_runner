  <BehaviorTree ID="SlalomCompetition">
    <Sequence _description="The slalom at the competition. Scan a layer color-blind, assume the middle pipe of the 3 closest ones is the red one, then cross the gap on the wanted side. Repeat for the 3 layers.">
      <SubTree ID="InitialSubmerge"
               Depth="0.5"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <Script code="ScanFrom := 0"/>
      <IfThenElse _description="The path we took from the gate tells us on which side the slalom is, so which way to sweep.">
        <ScriptCondition code="Path==&quot;search-rescue&quot;"/>
        <Script code="ScanTo := -180"/>
        <Script code="ScanTo := 180"/>
      </IfThenElse>
      <Sequence _description="First layer: full half sweep because we only roughly know where the slalom is.">
        <InitializeSlalomPoints Points="{SlalomPoints}"/>
        <SubTree ID="ScanSlalomLayer"
                 From="{ScanFrom}"
                 To="{ScanTo}"
                 Points="{SlalomPoints}"/>
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <ComputeSlalomGateTrajectory Points="{SlalomPoints}"
                                     Side="{Side}"
                                     ClusterTolerance="0.7"
                                     MinPointsPerCluster="3"
                                     MaxGateRange="10.0"
                                     ApproachStandoff="1.0"
                                     PassDistance="2.0"
                                     GateHeading="{GateHeading}"
                                     Trajectory="{Trajectory}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="20"/>
      </Sequence>
      <Repeat num_cycles="2">
        <Sequence _description="Next layers: they are roughly in front of us after crossing a gate, so a narrow sweep around the gate heading is enough.">
          <Script code="ScanFrom := GateHeading - 60"/>
          <Script code="ScanTo := GateHeading + 60"/>
          <InitializeSlalomPoints Points="{SlalomPoints}"/>
          <SubTree ID="ScanSlalomLayer"
                   From="{ScanFrom}"
                   To="{ScanTo}"
                   Points="{SlalomPoints}"/>
          <InitializeTrajectory trajectory="{Trajectory}"/>
          <ComputeSlalomGateTrajectory Points="{SlalomPoints}"
                                       Side="{Side}"
                                       ClusterTolerance="0.7"
                                       MinPointsPerCluster="3"
                                       MaxGateRange="10.0"
                                       ApproachStandoff="1.0"
                                       PassDistance="2.0"
                                       GateHeading="{GateHeading}"
                                       Trajectory="{Trajectory}"/>
          <SubTree ID="SendTrajectoryOnly"
                   Trajectory="{Trajectory}"
                   TimeBeforeFailing="20"/>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlalomFinal">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="SlalomSemiFinal">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.8"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"
                    _description="Activate the AI.&#10;&#10;I have no idea which model to choose to be defined."/>
      <Sequence>
        <SubTree ID="SearchClosestRedSlalom"/>
        <SearchClosestSlalom Object_class="RED_SLALOM"
                             Side="&quot;&quot;"
                             Actual_angle="-1"
                             Closest_object_angle="{_a}"
                             Closest_object="{RedSlalomDetection}"
                             Max_frame_before_failing="0"
                             Min_detections_before_success="5"
                             Max_depth="25.000000"
                             Confidence="0.600000"
                             Max_time_before_failing_sec="5.0"
                             Camera="1"/>
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <FaceTheObject Trajectory="{Trajectory}"
                       Detection="{RedSlalomDetection}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="5"/>
        <SubTree ID="SearchClosestWhiteSlalom"
                 Side="{Side}"
                 RedDetection="{RedSlalomDetection}"
                 WhiteDetection="{WhiteSlalomDetection}"
                 WhiteDetectionAngle="{DetectionAngle}"
                 OffsetAngle="{OffsetAngle}"/>
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <ComputeTrajectoryBetweenDetections Trajectory="{Trajectory}"
                                            OffsetAngle="{OffsetAngle}"
                                            Side="{Side}"
                                            Angle="{DetectionAngle}"
                                            DetectionB="{RedSlalomDetection}"
                                            PositionX="1.500000"
                                            DetectionA="{WhiteSlalomDetection}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="15"/>
      </Sequence>
      <Repeat num_cycles="2">
        <Sequence>
          <SubTree ID="QuickSearchClosestRedSlalom"/>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="-1"
                               Closest_object_angle="{_a}"
                               Closest_object="{RedSlalomDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.0"
                               Camera="1"/>
          <InitializeTrajectory trajectory="{Trajectory}"/>
          <FaceTheObject Trajectory="{Trajectory}"
                         Detection="{RedSlalomDetection}"/>
          <SubTree ID="SendTrajectoryOnly"
                   Trajectory="{Trajectory}"
                   TimeBeforeFailing="5"/>
          <SubTree ID="QuickSearchClosestWhiteSlalom"
                   Side="{Side}"
                   RedDetection="{RedSlalomDetection}"
                   WhiteDetection="{WhiteSlalomDetection}"
                   WhiteDetectionAngle="{DetectionAngle}"
                   OffsetAngle="{OffsetAngle}"/>
          <InitializeTrajectory trajectory="{Trajectory}"/>
          <ComputeTrajectoryBetweenDetections Trajectory="{Trajectory}"
                                              OffsetAngle="{OffsetAngle}"
                                              Side="{Side}"
                                              Angle="{DetectionAngle}"
                                              DetectionB="{RedSlalomDetection}"
                                              PositionX="0.2"
                                              DetectionA="{WhiteSlalomDetection}"/>
          <SubTree ID="SendTrajectoryOnly"
                   Trajectory="{Trajectory}"
                   TimeBeforeFailing="15"/>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="ComputeSlalomGateTrajectory">
      <input_port name="Points"
                  type="SlalomPointArray">The points accumulated by the scan</input_port>
      <input_port name="Side"
                  type="std::string">Left or Right, the side of the red pipe where the sub must pass</input_port>
      <input_port name="ClusterTolerance"
                  default="0.700000"
                  type="float">Maximum distance in meters between two points of the same pipe</input_port>
      <input_port name="MinPointsPerCluster"
                  default="3"
                  type="int">Minimum number of points for a cluster to count as a pipe</input_port>
      <input_port name="MaxGateRange"
                  default="10.000000"
                  type="float">Pipes further than this distance in meters are ignored</input_port>
      <input_port name="ApproachStandoff"
                  default="1.000000"
                  type="float">Distance in meters before the gap where the sub stops to align itself</input_port>
      <input_port name="PassDistance"
                  default="2.000000"
                  type="float">Forward distance in meters to travel after the gap</input_port>
      <output_port name="GateHeading"
                   type="float">Absolute heading perpendicular to the gate, used to scan the next layer</output_port>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
    </Action>
    <Action ID="ComputeTrajectoryBetweenDetections">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="OffsetAngle"
                  type="float"/>
      <input_port name="Side"
                  type="std::string"/>
      <input_port name="Angle"
                  type="float"/>
      <input_port name="DetectionB"
                  type="AiDetection"/>
      <input_port name="PositionX"
                  default="10.000000"
                  type="float">Forward distance to travel after centering between the two detections</input_port>
      <input_port name="DetectionA"
                  type="AiDetection"/>
    </Action>
    <Action ID="FaceTheObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <Action ID="HasDetection">
      <input_port name="Detected_object"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <Action ID="InitializeSlalomPoints">
      <output_port name="Points"
                   type="SlalomPointArray"/>
    </Action>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">0 : Abs, 1 : Rot and Trans Rel, 2 : Rot Abs and Trans Rel, 3 : Rot Rel and Trans Abs, 4 : Prof Abs</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">rotation in Z to give to the sub</input_port>
    </SubTree>
    <Action ID="MoveToObject">
      <input_port name="Offset"
                  type="float"/>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="QuickSearchClosestWhiteSlalom"
             editable="true">
      <input_port name="Side"/>
      <input_port name="RedDetection"/>
      <output_port name="WhiteDetection"/>
      <output_port name="WhiteDetectionAngle"/>
      <output_port name="OffsetAngle"/>
    </SubTree>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle">Angle to put to the sub</input_port>
    </SubTree>
    <SubTree ID="ScanSlalomLayer"
             editable="true">
      <input_port name="From"
                  type="double">Absolute angle where the sweep starts</input_port>
      <input_port name="To"
                  type="double">Absolute angle where the sweep ends</input_port>
      <inout_port name="Points"
                  type="SlalomPointArray">Accumulated slalom points, relative to the scan position</inout_port>
    </SubTree>
    <Action ID="SearchClosestSlalom">
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Side"
                  type="std::string">Side that the white slalom should be from the red slalom</input_port>
      <input_port name="Actual_angle"
                  type="float">The actual angle of the sub</input_port>
      <inout_port name="Closest_object_angle"
                  type="float">The closest detection angle</inout_port>
      <inout_port name="Closest_object"
                  type="AiDetection">The closest detected object</inout_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="unsigned long">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <SubTree ID="SearchClosestWhiteSlalom"
             editable="true">
      <input_port name="Side"/>
      <input_port name="RedDetection"/>
      <output_port name="WhiteDetection"/>
      <output_port name="WhiteDetectionAngle"/>
      <output_port name="OffsetAngle"/>
    </SubTree>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailing"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
    <Action ID="SlalomScan">
      <input_port name="Actual_angle"
                  type="float">The actual absolute angle of the sub</input_port>
      <input_port name="Invert_camera_angle"
                  default="false"
                  type="bool">Flip the sign convention of the camera angle if the computed points are mirrored</input_port>
      <inout_port name="Points"
                  type="SlalomPointArray">The accumulated slalom points, relative to the sub position during the scan</inout_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="unsigned long">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
  </TreeNodesModel>

</root>
