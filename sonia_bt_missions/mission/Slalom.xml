<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="SearchClosestRedSlalom">
    <Sequence>
      <Sequence>
        <SubTree ID="RotateToAbsoluteAngle"
                 Angle="0"/>
        <ForceSuccess>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="0"
                               Closest_object_angle="{ClosestObjectAngle}"
                               Closest_object="{ClosestObjectDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.00000"
                               Camera="1"/>
        </ForceSuccess>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="-25"/>
        <ForceSuccess>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="-25"
                               Closest_object_angle="{ClosestObjectAngle}"
                               Closest_object="{ClosestObjectDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.00000"
                               Camera="1"/>
        </ForceSuccess>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="-25"/>
        <ForceSuccess>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="-50"
                               Closest_object_angle="{ClosestObjectAngle}"
                               Closest_object="{ClosestObjectDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.00000"
                               Camera="1"/>
        </ForceSuccess>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="75"/>
        <ForceSuccess>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="25"
                               Closest_object_angle="{ClosestObjectAngle}"
                               Closest_object="{ClosestObjectDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.00000"
                               Camera="1"/>
        </ForceSuccess>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="25"/>
        <ForceSuccess>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="50"
                               Closest_object_angle="{ClosestObjectAngle}"
                               Closest_object="{ClosestObjectDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.00000"
                               Camera="1"/>
        </ForceSuccess>
      </Sequence>
      <Sequence>
        <HasDetection Detected_object="{ClosestObjectDetection}"/>
        <SubTree ID="RotateToAbsoluteAngle"
                 Angle="{ClosestObjectAngle}"/>
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <MoveToObject Trajectory="{Trajectory}"
                      Offset="-1.5"
                      Detection="{ClosestObjectDetection}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="10"/>
      </Sequence>
      <IfThenElse>
        <ScriptCondition code="ClosestObjectAngle&gt;0"/>
        <Sequence>
          <SubTree ID="MoveSinglePose"
                   frame="1.0"
                   positionX="0.0"
                   positionY="0.5"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="0.0"/>
          <SubTree ID="MoveSinglePose"
                   frame="1.0"
                   positionX="0.0"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="-18"/>
        </Sequence>
        <Sequence>
          <SubTree ID="MoveSinglePose"
                   frame="1.0"
                   positionX="0.0"
                   positionY="-0.5"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="0.0"/>
          <SubTree ID="MoveSinglePose"
                   frame="1.0"
                   positionX="0.0"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="18"/>
        </Sequence>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SearchClosestWhiteSlalom">
    <Sequence>
      <Sequence name="Looking for the closest white slalom depending on the side">
        <ForceSuccess>
          <SearchClosestSlalom Object_class="WHITE_SLALOM"
                               Side="{Side}"
                               Actual_angle="0"
                               Closest_object_angle="{WhiteDetectionAngle}"
                               Closest_object="{WhiteDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.00000"
                               Camera="1"/>
        </ForceSuccess>
        <IfThenElse>
          <ScriptCondition code="Side==&quot;Left&quot;"/>
          <Sequence>
            <SubTree ID="MoveSinglePose"
                     frame="1.0"
                     positionX="0.0"
                     positionY="0.0"
                     positionZ="0.0"
                     orientationX="0.0"
                     orientationY="0.0"
                     orientationZ="-25"/>
            <ForceSuccess>
              <SearchClosestSlalom Object_class="WHITE_SLALOM"
                                   Side="{Side}"
                                   Actual_angle="-25"
                                   Closest_object_angle="{WhiteDetectionAngle}"
                                   Closest_object="{WhiteDetection}"
                                   Max_frame_before_failing="0"
                                   Min_detections_before_success="5"
                                   Max_depth="25.000000"
                                   Confidence="0.600000"
                                   Max_time_before_failing_sec="5.00000"
                                   Camera="1"/>
            </ForceSuccess>
            <SubTree ID="MoveSinglePose"
                     frame="1.0"
                     positionX="0.0"
                     positionY="0.0"
                     positionZ="0.0"
                     orientationX="0.0"
                     orientationY="0.0"
                     orientationZ="-25"/>
            <ForceSuccess>
              <SearchClosestSlalom Object_class="WHITE_SLALOM"
                                   Side="{Side}"
                                   Actual_angle="-50"
                                   Closest_object_angle="{WhiteDetectionAngle}"
                                   Closest_object="{WhiteDetection}"
                                   Max_frame_before_failing="0"
                                   Min_detections_before_success="5"
                                   Max_depth="25.000000"
                                   Confidence="0.600000"
                                   Max_time_before_failing_sec="5.00000"
                                   Camera="1"/>
            </ForceSuccess>
            <Script code="OffsetAngle := -50"/>
          </Sequence>
          <Sequence>
            <SubTree ID="MoveSinglePose"
                     frame="1.0"
                     positionX="0.0"
                     positionY="0.0"
                     positionZ="0.0"
                     orientationX="0.0"
                     orientationY="0.0"
                     orientationZ="25"/>
            <ForceSuccess>
              <SearchClosestSlalom Object_class="WHITE_SLALOM"
                                   Side="{Side}"
                                   Actual_angle="25"
                                   Closest_object_angle="{WhiteDetectionAngle}"
                                   Closest_object="{WhiteDetection}"
                                   Max_frame_before_failing="0"
                                   Min_detections_before_success="5"
                                   Max_depth="25.000000"
                                   Confidence="0.600000"
                                   Max_time_before_failing_sec="5.00000"
                                   Camera="1"/>
            </ForceSuccess>
            <SubTree ID="MoveSinglePose"
                     frame="1.0"
                     positionX="0.0"
                     positionY="0.0"
                     positionZ="0.0"
                     orientationX="0.0"
                     orientationY="0.0"
                     orientationZ="25"/>
            <ForceSuccess>
              <SearchClosestSlalom Object_class="WHITE_SLALOM"
                                   Side="{Side}"
                                   Actual_angle="50"
                                   Closest_object_angle="{WhiteDetectionAngle}"
                                   Closest_object="{WhiteDetection}"
                                   Max_frame_before_failing="0"
                                   Min_detections_before_success="5"
                                   Max_depth="25.000000"
                                   Confidence="0.600000"
                                   Max_time_before_failing_sec="5.00000"
                                   Camera="1"/>
            </ForceSuccess>
            <Script code="OffsetAngle := 50"/>
          </Sequence>
        </IfThenElse>
        <HasDetection Detected_object="{WhiteDetection}"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlalomFinal">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="SlalomSemiFinal">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="0.5"/>
      <AiActivation Bottom="false"
                    Model="0"
                    Front="true"
                    _description="Activate the AI.&#10;&#10;I have no idea which model to choose to be defined."/>
      <SubTree ID="SearchClosestRedSlalom"/>
      <SearchClosestSlalom Object_class="RED_SLALOM"
                           Side="&quot;&quot;"
                           Actual_angle="-1"
                           Closest_object_angle="{_a}"
                           Closest_object="{RedSlalomDetection}"
                           Max_frame_before_failing="0"
                           Min_detections_before_success="5"
                           Max_depth="25.000000"
                           Confidence="0.600000"
                           Max_time_before_failing_sec="5.00000"
                           Camera="1"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <FaceTheObject Trajectory="{Trajectory}"
                     Detection="{RedSlalomDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <SubTree ID="SearchClosestWhiteSlalom"
               Side="{Side}"
               RedDetection="{RedSlalomDetection}"
               WhiteDetection="{WhiteSlalomDetection}"
               WhiteDetectionAngle="{DetectionAngle}"
               OffsetAngle="{OffsetAngle}"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <ComputeTrajectoryBetweenDetections Trajectory="{Trajectory}"
                                          OffsetAngle="{OffsetAngle}"
                                          Side="{Side}"
                                          Angle="{DetectionAngle}"
                                          DetectionB="{RedSlalomDetection}"
                                          PositionX="5.000000"
                                          DetectionA="{WhiteSlalomDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="15"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="ComputeTrajectoryBetweenDetections">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="OffsetAngle"
                  type="float"/>
      <input_port name="Side"
                  type="std::string"/>
      <input_port name="Angle"
                  type="float"/>
      <input_port name="DetectionB"
                  type="AiDetection"/>
      <input_port name="PositionX"
                  default="10.000000"
                  type="float">Forward distance to travel after centering between the two detections</input_port>
      <input_port name="DetectionA"
                  type="AiDetection"/>
    </Action>
    <Action ID="FaceTheObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <Action ID="HasDetection">
      <input_port name="Detected_object"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">0 : Abs, 1 : Rot and Trans Rel, 2 : Rot Abs and Trans Rel, 3 : Rot Rel and Trans Abs, 4 : Prof Abs</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">rotation in Z to give to the sub</input_port>
    </SubTree>
    <Action ID="MoveToObject">
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Offset"
                  type="float"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle">Angle to put to the sub</input_port>
    </SubTree>
    <Action ID="SearchClosestSlalom">
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Side"
                  type="std::string">Side that the white slalom should be from the red slalom</input_port>
      <input_port name="Actual_angle"
                  type="float">The actual angle of the sub</input_port>
      <inout_port name="Closest_object_angle"
                  type="float">The closest detection angle</inout_port>
      <inout_port name="Closest_object"
                  type="AiDetection">The closest detected object</inout_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="unsigned long">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <SubTree ID="SearchClosestWhiteSlalom"
             editable="true">
      <input_port name="Side"/>
      <input_port name="RedDetection"/>
      <output_port name="WhiteDetection"/>
      <output_port name="WhiteDetectionAngle"/>
      <output_port name="OffsetAngle"/>
    </SubTree>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailing"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
