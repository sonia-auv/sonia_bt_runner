<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="SearchClosestWhiteSlalom">
    <Sequence>
      <SubTree ID="RotateToAbsoluteAngle"
               Angle="0"/>
      <SearchClosestSlalom Object_class="WHITE_SLALOM"
                           Closest_object="{ClosestObject}"
                           Camera="1"
                           Confidence="0.600000"
                           Closest_object_angle="{ClosestObjectAngle}"
                           Max_depth="25.000000"
                           Actual_angle="0"
                           Min_detections_before_success="5"
                           Max_frame_before_failing="0"
                           Max_time_before_failing_sec="5.00000"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="-25"/>
      <SearchClosestSlalom Object_class="WHITE_SLALOM"
                           Closest_object="{ClosestObject}"
                           Camera="1"
                           Confidence="0.600000"
                           Closest_object_angle="{ClosestObjectAngle}"
                           Max_depth="25.000000"
                           Actual_angle="-25"
                           Min_detections_before_success="5"
                           Max_frame_before_failing="0"
                           Max_time_before_failing_sec="5.00000"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="-25"/>
      <SearchClosestSlalom Object_class="WHITE_SLALOM"
                           Closest_object="{ClosestObject}"
                           Camera="1"
                           Confidence="0.600000"
                           Closest_object_angle="{ClosestObjectAngle}"
                           Max_depth="25.000000"
                           Actual_angle="-50"
                           Min_detections_before_success="5"
                           Max_frame_before_failing="0"
                           Max_time_before_failing_sec="5.00000"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="75"/>
      <SearchClosestSlalom Object_class="WHITE_SLALOM"
                           Closest_object="{ClosestObject}"
                           Camera="1"
                           Confidence="0.600000"
                           Closest_object_angle="{ClosestObjectAngle}"
                           Max_depth="25.000000"
                           Actual_angle="25"
                           Min_detections_before_success="5"
                           Max_frame_before_failing="0"
                           Max_time_before_failing_sec="5.00000"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="25"/>
      <SearchClosestSlalom Object_class="WHITE_SLALOM"
                           Closest_object="{ClosestObject}"
                           Camera="1"
                           Confidence="0.600000"
                           Closest_object_angle="{ClosestObjectAngle}"
                           Max_depth="25.000000"
                           Actual_angle="50"
                           Min_detections_before_success="5"
                           Max_frame_before_failing="0"
                           Max_time_before_failing_sec="5.00000"/>
      <SubTree ID="RotateToAbsoluteAngle"
               Angle="MoveSinglePose"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <MoveToObject Offset="-2"
                    Trajectory="{Trajectory}"
                    Detection="{ClosestObject}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="10"/>
      <IfThenElse>
        <ScriptCondition code="ClosestObjectAngle&gt;0"/>
        <Script code="SlalomSideFromGate:=&quot;Right&quot;"/>
        <Script code="SlalomSideFromGate:=&quot;Left&quot;"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlalomFinal">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="SlalomSemiFinal">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="1.0"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"
                    _description="Activate the AI.&#10;&#10;I have no idea which model to choose to be defined."/>
      <InitializeTrajectory trajectory="{Trajectory}"
                            _description="Prepare trajectory to face the red slalom."/>
      <MoveToObject Offset="-2"
                    Trajectory="{Trajectory}"
                    Detection="{RedSlalomDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <IfThenElse>
        <ScriptCondition code="Side==&quot;Left&quot;"/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="-20.0"/>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="20.0"/>
      </IfThenElse>
      <AiFilter Detected_object="{RedSlalomDetection}"
                Max_time_before_failing_sec="5.0"
                Max_frame_before_failing="0"
                Min_detections_before_success="5"
                Confidence="0.60000"
                Max_depth="25.0"
                Object_class="RED_SLALOM"
                Camera="1"
                _description="Refresh the red slalom detection."/>
      <SearchWhiteSlalom WhiteSlalomDetection="{WhiteSlalomDetection}"
                         Max_time_before_failing_sec="5.000000"
                         Max_depth="2.000000"
                         Confidence="0.600000"
                         Min_detections_before_success="5"
                         Side="{Side}"
                         RedSlalomDetection="{RedSlalomDetection}"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <ComputeTrajectoryBetweenDetections Side="{Side}"
                                          Trajectory="{Trajectory}"
                                          PositionX="10.000000"
                                          DetectionB="{RedSlalomDetection}"
                                          DetectionA="{WhiteSlalomDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="15"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
      <output_port name="Detected_object"
                   type="AiDetection"/>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed time in ms before failing the object research</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="int">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <Action ID="ComputeTrajectoryBetweenDetections">
      <input_port name="Side"
                  type="std::string"/>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="PositionX"
                  default="10.000000"
                  type="float">Forward distance to travel after centering between the two detections</input_port>
      <input_port name="DetectionB"
                  type="AiDetection"/>
      <input_port name="DetectionA"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">0 : Abs, 1 : Rot and Trans Rel, 2 : Rot Abs and Trans Rel, 3 : Rot Rel and Trans Abs, 4 : Prof Abs</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">rotation in Z to give to the sub</input_port>
    </SubTree>
    <Action ID="MoveToObject">
      <input_port name="Offset"
                  type="float"/>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="Detection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle">Angle to put to the sub</input_port>
    </SubTree>
    <Action ID="SearchClosestSlalom">
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <inout_port name="Closest_object"
                  type="AiDetection">The closest detected object</inout_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <inout_port name="Closest_object_angle"
                  type="float">The closest detection angle</inout_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Actual_angle"
                  type="float">The actual angle of the sub</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="unsigned long">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed frames before failing the object research</input_port>
    </Action>
    <Action ID="SearchWhiteSlalom">
      <output_port name="WhiteSlalomDetection"
                   type="AiDetection"/>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Timeout in seconds, 0 = disabled</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum detection distance</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Minimum AI confidence</input_port>
      <input_port name="Min_detections_before_success"
                  default="5"
                  type="int">Minimum valid detections before succeeding</input_port>
      <input_port name="Side"
                  default="Left"
                  type="std::string">Left or Right</input_port>
      <input_port name="RedSlalomDetection"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailing"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
