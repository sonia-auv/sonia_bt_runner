<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="QuickSearchClosestRedSlalom">
    <Sequence>
      <Sequence>
        <ForceSuccess>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="0"
                               Closest_object_angle="{ClosestObjectAngle}"
                               Closest_object="{ClosestObjectDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.0"
                               Camera="1"/>
        </ForceSuccess>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="-25"/>
        <ForceSuccess>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="-25"
                               Closest_object_angle="{ClosestObjectAngle}"
                               Closest_object="{ClosestObjectDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.0"
                               Camera="1"/>
        </ForceSuccess>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="50"/>
        <ForceSuccess>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="25"
                               Closest_object_angle="{ClosestObjectAngle}"
                               Closest_object="{ClosestObjectDetection}"
                               Max_frame_before_failing="0"
                               Min_detections_before_success="5"
                               Max_depth="25.000000"
                               Confidence="0.600000"
                               Max_time_before_failing_sec="5.0"
                               Camera="1"/>
        </ForceSuccess>
      </Sequence>
      <Sequence>
        <HasDetection Detected_object="{ClosestObjectDetection}"/>
        <Script code="rotate:=25 - ClosestObjectAngle"/>
        <IfThenElse>
          <ScriptCondition code="rotate != 0"/>
          <SubTree ID="MoveSinglePose"
                   frame="1.0"
                   positionX="0.0"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0"
                   orientationZ="{rotate}"/>
          <AlwaysSuccess/>
        </IfThenElse>
        <InitializeTrajectory trajectory="{Trajectory}"/>
        <FaceTheObject Trajectory="{Trajectory}"
                       Detection="{ClosestObjectDetection}"/>
        <SubTree ID="SendTrajectoryOnly"
                 Trajectory="{Trajectory}"
                 TimeBeforeFailing="10"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

