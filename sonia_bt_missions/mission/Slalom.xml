        </ForceSuccess>
        <SubTree ID="MoveSinglePose"
                 frame="1.0"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="75"/>
        <ForceSuccess>
          <SearchClosestSlalom Object_class="RED_SLALOM"
                               Side="&quot;&quot;"
                               Actual_angle="25"
                               Closest_object_angle="{ClosestObjectAngle}"
                               Closest_object="{ClosestObjectDetection}"
