<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="MapSlalomsToStart">
    <Sequence>
      <Script code="Position := -1"/>
      <RetryUntilSuccessful num_attempts="10">
        <Sequence>
          <InitializeTrajectory trajectory="{Trajectory}"/>
          <MapSlaloms Camera="1"
                      Confidence="0.600000"
                      Max_depth="3.000000"
                      Min_detections_before_success="30"
                      Max_frame_before_failing="0"
                      Max_time_before_failing_sec="20.000000"
                      Side="{Side}"
                      Slalom_side="{Slalom_side}"
                      Step_distance="1.0"
                      Position="{Position}"
                      Trajectory="{Trajectory}"/>
          <Fallback>
            <ScriptCondition code="(Side==&apos;Left&apos; &amp;&amp; Position==2) || (Side==&apos;Right&apos; &amp;&amp; Position==4)"/>
            <ForceFailure>
              <SubTree ID="SendTrajectoryOnly"
                       Trajectory="{Trajectory}"
                       TimeBeforeFailing="10"/>
            </ForceFailure>
          </Fallback>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SlalomFinal">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="SlalomSemiFinal">
    <Sequence>
      <SubTree ID="InitialSubmerge"
               Depth="1.0"/>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"
                    _description="Activate the AI.&#10;&#10;I have no idea which model to choose to be defined."/>
      <SubTree ID="MapSlalomsToStart"
               Side="{Side}"
               Slalom_side="{Slalom_side}"
               _description="Drive the sub to position 2 (Left) or 4 (Right) so the red and a white are on the same line."/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="5"/>
      <AiFilter Detected_object="{RedSlalomDetection}"
                Max_time_before_failing_sec="5.0"
                Max_frame_before_failing="0"
                Min_detections_before_success="5"
                Confidence="0.60000"
                Max_depth="25.0"
                Object_class="RED_SLALOM"
                Camera="1"
                _description="Refresh the red slalom detection."/>
      <SearchWhiteSlalom WhiteSlalomDetection="{WhiteSlalomDetection}"
                         Max_time_before_failing_sec="5.000000"
                         Max_depth="2.000000"
                         Confidence="0.600000"
                         Min_detections_before_success="5"
                         Side="{Side}"
                         RedSlalomDetection="{RedSlalomDetection}"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <ComputeTrajectoryBetweenDetections Side="{Side}"
                                          Trajectory="{Trajectory}"
                                          PositionX="10.000000"
                                          DetectionB="{RedSlalomDetection}"
                                          DetectionA="{WhiteSlalomDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailing="15"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
      <output_port name="Detected_object"
                   type="AiDetection"/>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Maximum allowed time in ms before failing the object research</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing the object research</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="int">Minumum number of frames with at least one detection before sending results. Need to be heigher than 2</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <Action ID="ComputeTrajectoryBetweenDetections">
      <input_port name="Side"
                  type="std::string"/>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
      <input_port name="PositionX"
                  default="10.000000"
                  type="float">Forward distance to travel after centering between the two detections</input_port>
      <input_port name="DetectionB"
                  type="AiDetection"/>
      <input_port name="DetectionA"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="InitialSubmerge"
             editable="true">
      <input_port name="Depth"
                  default="0.5"/>
    </SubTree>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Action ID="MapSlaloms">
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_depth"
                  default="25.000000"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Min_detections_before_success"
                  default="2"
                  type="int">Minimum frames with a detection before mapping</input_port>
      <input_port name="Max_frame_before_failing"
                  default="0"
                  type="int">Maximum allowed frames before failing</input_port>
      <input_port name="Max_time_before_failing_sec"
                  default="0.000000"
                  type="float">Timeout in seconds, 0 = disabled</input_port>
      <input_port name="Side"
                  type="std::string">Side the sub should take (Left or Right)</input_port>
      <input_port name="Slalom_side"
                  type="std::string">Side the slalom is on relative to the sub (Left or Right)</input_port>
      <input_port name="Step_distance"
                  default="0.500000"
                  type="float">Lateral distance in meters per position step</input_port>
      <inout_port name="Position"
                  default="-1"
                  type="int">Estimated position around the slalom (1..5, -1 = unknown)</inout_port>
      <inout_port name="Trajectory"
                  type="Trajectory"/>
    </Action>
