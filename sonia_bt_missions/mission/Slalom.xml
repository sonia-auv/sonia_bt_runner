                                 Max_depth="25.000000"
                                 Confidence="0.600000"
                                 Max_time_before_failing_sec="5.00000"
                                 Camera="1"/>
          </ForceSuccess>
          <Script code="OffsetAngle := -25"/>
        </Sequence>
        <Sequence>
          <SubTree ID="MoveSinglePose"
                   frame="1.0"
                   positionX="0.0"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="25"/>
          <ForceSuccess>
            <SearchClosestSlalom Object_class="WHITE_SLALOM"
                                 Side="{Side}"
                                 Actual_angle="25"
                                 Closest_object_angle="{WhiteDetectionAngle}"
                                 Closest_object="{WhiteDetection}"
